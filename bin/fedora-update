#!/usr/bin/env bash
# bin/fedora-update - Unified Fedora Fleet Maintenance & Toolchain Engine
#

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source Libraries
# shellcheck source=lib/common.sh
source "$ROOT_DIR/lib/common.sh"
# shellcheck source=lib/process.sh
source "$ROOT_DIR/lib/process.sh"
# shellcheck source=lib/git_guard.sh
source "$ROOT_DIR/lib/git_guard.sh"

# Source Modules
for mod in "$ROOT_DIR/modules/"*.sh; do
    if [ -f "$mod" ]; then
        # shellcheck disable=SC1090
        source "$mod"
    fi
done

# CLI Flags
DO_TRIM=false
ONLY_MODULE=""
declare -a SKIP_MODULES=()
DRY_RUN=false
export DRY_RUN

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Unified 1-click update and toolchain maintenance suite for Fedora.

Options:
  --trim             Perform full SSD TRIM (fstrim -av) during cleanup
  --only=<module>    Run only the specified module
                     (core|dnf|flatpak|firmware|ai|dev|git|self|cleanup)
  --skip=<modules>   Skip one or more modules; comma-separated or repeated
                     e.g. --skip=dnf,flatpak  or  --skip=dnf --skip=flatpak
  --dry-run, -n      Preview what would run without making any system changes
  -h, --help         Display this help message

Commands:
  update             Runs standard routine maintenance
  update-all         Runs standard maintenance + SSD TRIM

Execution order (all sequential):
  core -> dnf -> flatpak -> firmware -> ai -> dev -> git -> self -> cleanup

EOF
    exit 0
}

# Parse Command-line Arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --trim)
            DO_TRIM=true
            shift
            ;;
        --only=*)
            ONLY_MODULE="${1#*=}"
            shift
            ;;
        --skip=*)
            IFS=',' read -ra _skips <<< "${1#*=}"
            SKIP_MODULES+=("${_skips[@]}")
            shift
            ;;
        --dry-run|-n)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            # Ignore unknown or legacy args gracefully
            shift
            ;;
    esac
done

should_run() {
    local mod_key="$1"
    if [ -n "$ONLY_MODULE" ] && [ "$ONLY_MODULE" != "$mod_key" ]; then
        return 1
    fi
    if [ "${#SKIP_MODULES[@]}" -gt 0 ]; then
        local _s
        for _s in "${SKIP_MODULES[@]}"; do
            [ "$_s" = "$mod_key" ] && return 1
        done
    fi
    return 0
}

# run_module key function [args...]
# Runs a module if it passes should_run, and prints its elapsed time.
run_module() {
    local key="$1"
    local fn="$2"
    shift 2
    if should_run "$key"; then
        local t0 t1
        t0=$(date +%s)
        "$fn" "$@"
        t1=$(date +%s)
        echo -e "  ${CYAN}[${key} time: $((t1 - t0))s]${RESET}"
    fi
}

main() {
    # Initialize logging
    init_logging

    local START_TIME
    START_TIME=$(date +%s)

    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${BOLD}${YELLOW}============================================================${RESET}"
        echo -e "${BOLD}${YELLOW}   DRY-RUN MODE — No system changes will be made           ${RESET}"
        echo -e "${BOLD}${YELLOW}============================================================${RESET}\n"
    fi

    echo -e "${BOLD}${CYAN}============================================================${RESET}"
    echo -e "${BOLD}${CYAN}          Starting Fedora Fleet Maintenance Suite           ${RESET}"
    echo -e "${BOLD}${CYAN}  Log File: $LOG_FILE${RESET}"
    echo -e "${BOLD}${CYAN}============================================================${RESET}\n"

    # Step 0: Ensure permissions and self-registered symlinks in ~/.local/bin
    chmod +x \
        "$ROOT_DIR/update" \
        "$ROOT_DIR/update-all" \
        "$ROOT_DIR/bin/fedora-update" \
        "$ROOT_DIR/lib/"*.sh \
        "$ROOT_DIR/modules/"*.sh 2>/dev/null || true

    mkdir -p "$HOME/.local/bin"
    if [ ! -L "$HOME/.local/bin/update" ] || [ "$(readlink -f "$HOME/.local/bin/update" 2>/dev/null)" != "$ROOT_DIR/update" ]; then
        ln -sf "$ROOT_DIR/update" "$HOME/.local/bin/update" 2>/dev/null || true
    fi
    if [ ! -L "$HOME/.local/bin/update-all" ] || [ "$(readlink -f "$HOME/.local/bin/update-all" 2>/dev/null)" != "$ROOT_DIR/update-all" ]; then
        ln -sf "$ROOT_DIR/update-all" "$HOME/.local/bin/update-all" 2>/dev/null || true
    fi
    if [ ! -L "$HOME/.local/bin/fedora-update" ] || [ "$(readlink -f "$HOME/.local/bin/fedora-update" 2>/dev/null)" != "$ROOT_DIR/bin/fedora-update" ]; then
        ln -sf "$ROOT_DIR/bin/fedora-update" "$HOME/.local/bin/fedora-update" 2>/dev/null || true
    fi

    # Step 0.5: Ensure passwordless sudo & polkit is verified / configured
    ensure_passwordless_sudo

    # Calculate total steps dynamically based on selected modules
    TOTAL_STEPS=0
    should_run "core"     && TOTAL_STEPS=$((TOTAL_STEPS + 18))
    should_run "dnf"      && TOTAL_STEPS=$((TOTAL_STEPS + 3))
    should_run "flatpak"  && TOTAL_STEPS=$((TOTAL_STEPS + 2))
    should_run "firmware" && TOTAL_STEPS=$((TOTAL_STEPS + 1))
    should_run "ai"       && TOTAL_STEPS=$((TOTAL_STEPS + 3))
    should_run "dev"      && TOTAL_STEPS=$((TOTAL_STEPS + 4))
    should_run "git"      && TOTAL_STEPS=$((TOTAL_STEPS + 1))
    should_run "self"     && TOTAL_STEPS=$((TOTAL_STEPS + 1))
    should_run "cleanup"  && {
        if [ "$DO_TRIM" = "true" ]; then
            TOTAL_STEPS=$((TOTAL_STEPS + 4))
        else
            TOTAL_STEPS=$((TOTAL_STEPS + 3))
        fi
    }

    # ── Sequential: Core Fleet Baseline ──────────────────────────────────────
    run_module "core" run_core_baseline

    # ── Sequential: OS Packages via DNF ──────────────────────────────────────
    run_module "dnf" run_system_dnf

    # ── Sequential: Flatpaks & Runtimes ──────────────────────────────────────
    run_module "flatpak" run_flatpak

    # ── Sequential: Hardware & System Firmware (LVFS) ────────────────────────
    run_module "firmware" run_firmware

    # ── Sequential: Secondary AI Runtimes ────────────────────────────────────
    run_module "ai" run_ai_runtimes

    # ── Sequential: Dev Toolchains ───────────────────────────────────────────
    run_module "dev" run_dev_toolchains

    # ── Sequential: Local Documentation & Git Repositories ───────────────────
    run_module "git" run_git_docs

    # ── Sequential: Self-Update (fedora-update suite) ────────────────────────
    run_module "self" run_self_update

    # ── Sequential: System Cleanup & Reboot Checks ───────────────────────────
    run_module "cleanup" run_cleanup "$DO_TRIM"

    local END_TIME DURATION
    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))

    echo -e "\n${BOLD}${GREEN}============================================================${RESET}"
    echo -e "${BOLD}${GREEN}  --- Update process complete in ${DURATION}s! ---${RESET}"
    echo -e "${CYAN}  Full execution log saved to: ${LOG_FILE}${RESET}"
    echo -e "${BOLD}${GREEN}============================================================${RESET}\n"

    # Desktop completion notification (graphical sessions only)
    if command -v notify-send &>/dev/null && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        notify-send \
            --icon=software-update-available \
            --urgency=normal \
            "Fedora Update Complete" \
            "Finished in ${DURATION}s. Log: $LOG_FILE" \
            2>/dev/null || true
    fi
}

main "$@"
