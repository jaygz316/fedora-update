#!/usr/bin/env bash
# update — Fedora Fleet Maintenance & Toolchain Sync Suite
#
# Keeps a fleet of Fedora machines fully updated with one command.
# Synced across machines via Syncthing (~/.gemini, ~/projects/).
#
# Usage: update [OPTIONS]
#   --force, -f      Close running apps to apply updates, then restart them
#   --trim           Also perform SSD TRIM (fstrim -av)
#   --only=MODULE    Run only one section: core|dnf|flatpak|firmware|ai|dev|git|self|cleanup
#   --skip=MODULES   Skip sections; comma-separated or repeated flag
#   --dry-run, -n    Preview steps without making system changes
#   -h, --help       Show this help
#
# Run order: core -> dnf -> flatpak -> firmware -> ai -> dev -> git -> self -> cleanup

set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
[ -z "$SCRIPT_PATH" ] && SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

###############################################################################
# PATH — all user toolchain binaries available on any node
###############################################################################
for _dir in \
    "$HOME/.local/bin" "$HOME/bin" "$HOME/.cargo/bin" "$HOME/.bun/bin" \
    "$HOME/.npm-global/bin" "$HOME/.lmstudio/bin" "$HOME/google-cloud-sdk/bin" \
    "$HOME/go/bin" "$HOME/Android/Sdk/cmdline-tools/latest/bin" \
    "$HOME/Android/Sdk/platform-tools" "$HOME/Android/Sdk/emulator" \
    "/opt/android-studio-preview/bin" "$HOME/.local/opt/android-studio-preview/bin"
do
    [ -d "$_dir" ] && [[ ":$PATH:" != *":$_dir:"* ]] && PATH="$_dir:$PATH"
done
export PATH
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env" 2>/dev/null || true
if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    \. "$NVM_DIR/nvm.sh" 2>/dev/null || true
fi

###############################################################################
# COLORS & ENVIRONMENT
###############################################################################
BOLD="\033[1m"; GREEN="\033[0;32m"; YELLOW="\033[0;33m"
RED="\033[0;31m"; CYAN="\033[0;36m"; MAGENTA="\033[0;35m"; RESET="\033[0m"
export PYTHONUNBUFFERED=1 GIT_TERMINAL_PROMPT=0 FORCE_COLOR=1 CLICOLOR_FORCE=1

###############################################################################
# STEP COUNTER & LOGGING HELPERS
###############################################################################
STEP_COUNT=0; TOTAL_STEPS=0; _SUDO_KEEPALIVE_PID=""; _STEP_START_TIME=0

format_duration() {
    local s="$1"
    if [ "$s" -ge 60 ]; then
        echo "$((s / 60))m $((s % 60))s"
    else
        echo "${s}s"
    fi
}

step() {
    STEP_COUNT=$((STEP_COUNT + 1))
    _STEP_START_TIME=$(date +%s)
    [ "$TOTAL_STEPS" -gt 0 ] \
        && echo -e "\n${BOLD}${GREEN}[+] [${STEP_COUNT}/${TOTAL_STEPS}] $1...${RESET}" \
        || echo -e "\n${BOLD}${GREEN}[+] [${STEP_COUNT}] $1...${RESET}"
}
skip_step() {
    STEP_COUNT=$((STEP_COUNT + 1))
    local title="$1" reason="${2:-not found}"
    [ "$TOTAL_STEPS" -gt 0 ] \
        && echo -e "\n${YELLOW}[-] [${STEP_COUNT}/${TOTAL_STEPS}] ${title} (${reason}, skipping)${RESET}" \
        || echo -e "\n${YELLOW}[-] [${STEP_COUNT}] ${title} (${reason}, skipping)${RESET}"
}
log_substep()  { echo -e "  ${BOLD}${CYAN}--> [$1/$2]${RESET} $3"; }
log_action()   { echo -e "  ${CYAN}... $1${RESET}"; }
log_info()     { echo -e "  ${BOLD}[*] $1${RESET}"; }
log_ok()       {
    if [ "$_STEP_START_TIME" -gt 0 ]; then
        local elapsed=$(( $(date +%s) - _STEP_START_TIME ))
        if [ "$elapsed" -ge 3 ]; then
            echo -e "  ${GREEN}[OK] $1 ${CYAN}(took $(format_duration "$elapsed"))${RESET}"
            _STEP_START_TIME=0
            return
        fi
    fi
    echo -e "  ${GREEN}[OK] $1${RESET}"
    _STEP_START_TIME=0
}
log_warn()     { echo -e "  ${YELLOW}^ WARNING: $1${RESET}"; }
log_err()      { echo -e "  ${RED}^ ERROR: $1${RESET}"; }
log_bootstrap(){ echo -e "  ${BOLD}${MAGENTA}--> [BOOTSTRAP] $1${RESET}"; }

# Execute a command, or in --dry-run mode just print it without running
run_or_dry() {
    if [ "${DRY_RUN:-false}" = "true" ]; then
        echo -e "  ${MAGENTA}[DRY-RUN] Would run: $*${RESET}"; return 0
    fi
    "$@"
}

###############################################################################
# LOGGING — tee to timestamped log + ~/.local/state/update/last-update.log
###############################################################################
init_logging() {
    local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/update"
    mkdir -p "$log_dir"
    LOG_FILE="$log_dir/update_$(date +%Y%m%d_%H%M%S).log"
    find "$log_dir" -name "update_*.log" -type f 2>/dev/null | sort -r | tail -n +11 | xargs -r rm -f
    exec > >(tee -a "$LOG_FILE" | tee "$log_dir/last-update.log") 2>&1
}

###############################################################################
# PASSWORDLESS SUDO & POLKIT AUTO-SETUP
###############################################################################
ensure_passwordless_sudo() {
    ! command -v sudo &>/dev/null && { log_warn "'sudo' not found."; return 0; }
    local sudoers_file="/etc/sudoers.d/$USER"
    local polkit_rule="/etc/polkit-1/rules.d/49-nopasswd-fedora-update.rules"

    _write_polkit_rule() {
        [ -d "/etc/polkit-1/rules.d" ] && [ ! -f "$polkit_rule" ] || return 0
        sudo tee "$polkit_rule" >/dev/null <<EOF
polkit.addRule(function(action, subject) {
    if (subject.user == "$USER" || subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
EOF
        sudo chmod 0644 "$polkit_rule" 2>/dev/null || true
    }

    if sudo -n true 2>/dev/null; then
        _write_polkit_rule
        log_ok "Passwordless sudo & Polkit verified."
    else
        echo -e "\n${BOLD}${CYAN}------------------------------------------------------------${RESET}"
        echo -e "${CYAN}  Configuring passwordless sudo for 1-click runs...${RESET}"
        echo -e "${BOLD}${CYAN}------------------------------------------------------------${RESET}"
        if [ -t 0 ] || [ -e /dev/tty ]; then
            if sudo -v; then
                echo "$USER ALL=(ALL:ALL) NOPASSWD: ALL" | sudo tee "$sudoers_file" >/dev/null
                sudo chmod 0440 "$sudoers_file"; sudo chown root:root "$sudoers_file" 2>/dev/null || true
                _write_polkit_rule
                sudo -n true 2>/dev/null \
                    && log_ok "Passwordless sudo configured for $USER." \
                    || log_warn "Configured rules but validation returned non-zero."
            else
                log_warn "Authentication failed. Privileged operations may prompt."
            fi
        else
            log_warn "Non-interactive session. Run 'update' in a terminal once to finish setup."
        fi
    fi

    # Keep sudo ticket alive for the duration of the run
    if sudo -n true 2>/dev/null; then
        while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &
        _SUDO_KEEPALIVE_PID=$!
        trap '[ -n "$_SUDO_KEEPALIVE_PID" ] && kill "$_SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT
    fi
}

###############################################################################
# PROCESS DETECTION & SAFE SHUTDOWN / RESTART
###############################################################################
_is_process_excluded() {
    local pid="$1"
    { [ "$pid" = "$$" ] || [ "$pid" = "${PPID:-0}" ] || [ "$pid" = "${BASHPID:-$$}" ]; } && return 0
    local comm; comm=$(ps -p "$pid" -o comm= 2>/dev/null || true)
    case "$comm" in pgrep|grep|bash|sh|zsh) return 0 ;; esac
    local cmdline; cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
    [[ "$cmdline" == *"telemetry_hook_bundle.js"* || "$cmdline" == *"fedora-update"* ]] && return 0
    return 1
}

_is_ancestor_process() {
    local target_pid="$1"
    local cur="$$"
    while [ -n "$cur" ] && [ "$cur" -gt 0 ] 2>/dev/null; do
        [ "$cur" = "$target_pid" ] && return 0
        cur=$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ' || true)
        [ -z "$cur" ] || [ "$cur" = "0" ] && break
    done
    return 1
}

get_android_studio_pids() {
    local pids; pids="$(pgrep -f 'com.intellij.idea.Main|/android-studio' 2>/dev/null || true)"
    if [ -z "$pids" ]; then
        pids="$(pgrep -x "studio.sh" 2>/dev/null || true; pgrep -x "studio64" 2>/dev/null || true; pgrep -x "studio" 2>/dev/null || true)"
    fi
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        local c; c=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
        [[ "$c" == *"android-studio"* || "$c" == *"com.intellij.idea.Main"* || "$c" == *"studio.sh"* || "$c" == *"studio"* ]] && valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

get_antigravity_desktop_pids() {
    local pids; pids="$(pgrep -x antigravity 2>/dev/null || true)"
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        local c; c=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
        [[ "$c" == *"/opt/antigravity/antigravity"* && "$c" != *"antigravity-cli"* && "$c" != *"antigravity-ide"* ]] && valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

get_antigravity_ide_pids() {
    local pids; pids="$(pgrep -x antigravity-ide 2>/dev/null || true)"
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

get_vscode_pids() {
    local pids; pids="$(pgrep -x code 2>/dev/null || true)"
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

get_cli_pids() {
    local name="$1"
    local pids; pids="$(pgrep -x "$name" 2>/dev/null || true)"
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        if [ "$name" = "herdr" ]; then
            local c; c=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
            [[ "$c" == *"server"* ]] && continue
        fi
        valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

is_android_studio_running()     { [ -n "$(get_android_studio_pids)" ]; }
is_antigravity_desktop_running() { [ -n "$(get_antigravity_desktop_pids)" ]; }
is_antigravity_ide_running()     { [ -n "$(get_antigravity_ide_pids)" ]; }
is_vscode_running()              { [ -n "$(get_vscode_pids)" ]; }
is_cli_running()                 { [ -n "$(get_cli_pids "$1")" ]; }

safe_stop_app() {
    local app_name="$1"
    local pids_fn="$2"
    local check_fn="$3"

    local pids; pids="$($pids_fn)"
    [ -z "$pids" ] && return 0

    if [ "${DRY_RUN:-false}" = "true" ]; then
        log_info "[DRY-RUN] Would safely shut down $app_name (PIDs: $pids), apply update, and restart."
        return 0
    fi

    # Ancestor protection: ensure none of the PIDs are ancestors of this script ($$)
    for pid in $pids; do
        if _is_ancestor_process "$pid"; then
            log_warn "$app_name (PID $pid) is an ancestor of this update process; skipping shutdown to protect current session."
            return 1
        fi
    done

    log_action "Sending graceful shutdown signal (SIGTERM) to $app_name..."

    # Identify root PIDs (whose parent is NOT in $pids) to trigger application graceful shutdown
    local root_pids=()
    for pid in $pids; do
        local ppid; ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
        if [[ ! " $pids " =~ " $ppid " ]]; then
            root_pids+=("$pid")
        fi
    done
    [ "${#root_pids[@]}" -eq 0 ] && root_pids=($pids)

    for pid in "${root_pids[@]}"; do
        kill -TERM "$pid" 2>/dev/null || true
    done

    # Wait up to 5 seconds for root processes to initiate shutdown and exit
    local waited=0
    while "$check_fn" && [ "$waited" -lt 10 ]; do
        sleep 0.5
        waited=$((waited + 1))
    done

    # If child processes or other PIDs are still lingering, send SIGTERM to all remaining PIDs
    if "$check_fn"; then
        local remaining; remaining="$($pids_fn)"
        for pid in $remaining; do
            kill -TERM "$pid" 2>/dev/null || true
        done
        while "$check_fn" && [ "$waited" -lt 30 ]; do
            sleep 0.5
            waited=$((waited + 1))
        done
    fi

    # If still running after 15 seconds, escalate to SIGKILL
    if "$check_fn"; then
        log_warn "$app_name did not terminate cleanly within 15s; sending SIGKILL..."
        local remaining; remaining="$($pids_fn)"
        for pid in $remaining; do
            kill -9 "$pid" 2>/dev/null || true
        done
        sleep 1
    fi

    if "$check_fn"; then
        log_err "Failed to stop $app_name; skipping update."
        return 1
    fi

    log_ok "$app_name shut down safely."
    return 0
}

restart_app() {
    local app_name="$1"
    local desktop_id="$2"
    local fallback_cmd="$3"

    if [ "${DRY_RUN:-false}" = "true" ]; then
        log_info "[DRY-RUN] Would restart $app_name."
        return 0
    fi

    log_info "Restarting $app_name..."

    # If in a desktop session (Wayland or X11), prefer desktop launcher via gtk-launch
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v gtk-launch &>/dev/null; then
        if gtk-launch "$desktop_id" 2>/dev/null; then
            log_ok "$app_name restarted via desktop launcher."
            return 0
        fi
    fi

    # Fallback to direct executable in background
    if [ -n "$fallback_cmd" ]; then
        nohup bash -c "$fallback_cmd" >/dev/null 2>&1 &
        disown 2>/dev/null || true
        log_ok "$app_name restarted in background."
        return 0
    fi

    log_warn "Could not restart $app_name (no launcher or command available)."
    return 1
}

###############################################################################
# GIT GUARD — Syncthing-safe git pull (skips on dirty working tree)
###############################################################################
safe_git_repo_update() {
    local repo_path="$1"
    local repo_name; repo_name="$(basename "$repo_path")"
    [ ! -d "$repo_path" ] && { log_warn "$repo_name not found, skipping."; return 0; }
    (
        cd "$repo_path" || return 1
        git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { log_warn "$repo_name is not a git repo."; return 1; }
        log_action "Inspecting $repo_name..."
        export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15"
        local dirty; dirty="$(git status --porcelain 2>/dev/null || true)"
        if [ -n "$dirty" ]; then
            echo -e "  ${YELLOW}[SKIP] Local changes in $repo_name; skipping pull to avoid Syncthing conflicts.${RESET}"
            return 0
        fi
        log_action "Fetching upstream for $repo_name..."
        timeout 45s git fetch --all --prune 2>/dev/null || { log_warn "Fetch timed out for $repo_name."; return 0; }
        local local_c upstream_c
        local_c="$(git rev-parse HEAD 2>/dev/null || true)"
        upstream_c="$(git rev-parse '@{u}' 2>/dev/null || true)"
        if [ -n "$local_c" ] && [ -n "$upstream_c" ] && [ "$local_c" = "$upstream_c" ]; then
            log_ok "$repo_name is already up to date."
        else
            log_info "Pulling upstream changes into $repo_name..."
            timeout 60s git pull --rebase --autostash \
                && log_ok "$repo_name synchronized." \
                || log_warn "Pull/rebase failed for $repo_name."
        fi
    ) || log_warn "Git operation failed on $repo_path"
}

###############################################################################
# SECTION: CORE FLEET BASELINE
# Guaranteed on every node. Installs if missing, updates if present.
###############################################################################
_update_or_install_go_tool() {
    local bin_name="$1" install_path="$2"
    local bin_path="$HOME/go/bin/$bin_name"
    if [ -x "$bin_path" ]; then
        local mod_line mod_path current_ver latest_ver
        mod_line="$(go version -m "$bin_path" 2>/dev/null | grep -E "^\s*mod\s+" | head -n 1)"
        mod_path="$(echo "$mod_line" | awk '{print $2}')"
        current_ver="$(echo "$mod_line" | awk '{print $3}')"
        if [ -n "$mod_path" ]; then
            latest_ver="$(curl -s --max-time 3 "https://proxy.golang.org/$mod_path/@latest" 2>/dev/null | grep -o '"Version":"[^"]*"' | cut -d'"' -f4 || true)"
        fi
        if [ -n "$current_ver" ] && [ -n "$latest_ver" ] && [ "$current_ver" = "$latest_ver" ]; then
            log_ok "$bin_name already up to date ($current_ver)."; return 0
        fi
    fi
    log_info "Installing/updating $bin_name..."
    go install "$install_path@latest"
}

run_core_baseline() {
    echo -e "\n${BOLD}${CYAN}============================================================${RESET}"
    echo -e "${BOLD}${CYAN}   Core Fleet Baseline: Verifying & Updating Essentials    ${RESET}"
    echo -e "${BOLD}${CYAN}============================================================${RESET}"

    local arch; arch=$(uname -m)   # shared by Antigravity Desktop + IDE steps below

    # 1. C/C++ Build Tools
    step "Core: C/C++ Build Toolchain (gcc, make, pkgconf)"
    if ! command -v gcc &>/dev/null || ! command -v make &>/dev/null; then
        log_bootstrap "Installing gcc, gcc-c++, make, pkgconf..."
        sudo dnf install -y gcc gcc-c++ make pkgconf-pkg-config 2>/dev/null || true
    fi
    command -v gcc &>/dev/null && log_ok "C/C++ build tools verified."

    # 2. Python & pip
    step "Core: Python 3 & pip"
    if ! python3 -c "import pip" &>/dev/null; then
        log_bootstrap "Installing python3-pip..."
        sudo dnf install -y python3-pip || python3 -m ensurepip --user || true
    fi
    python3 -c "import pip" &>/dev/null \
        && { python3 -m pip install --user --upgrade pip 2>/dev/null || true; log_ok "pip up to date."; } \
        || log_warn "pip installation could not be completed."

    # 3. Astral uv
    step "Core: Astral uv package manager"
    if ! command -v uv &>/dev/null; then
        log_bootstrap "Installing Astral uv..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
        export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    else
        uv self update 2>/dev/null || true; log_ok "uv up to date."
    fi

    # 4. Node.js Runtime (nvm / DNF)
    step "Core: Node.js Runtime"
    local node_updated=false
    if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
        export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
        \. "$NVM_DIR/nvm.sh" 2>/dev/null || true
    fi

    if type -t nvm &>/dev/null; then
        local current_node remote_lts
        current_node="$(nvm current 2>/dev/null || true)"
        remote_lts="$(nvm version-remote --lts 2>/dev/null || true)"
        if [ -n "$remote_lts" ] && [ "$remote_lts" != "N/A" ]; then
            if [ -n "$current_node" ] && [ "$current_node" = "$remote_lts" ]; then
                log_ok "Node.js (nvm LTS) up to date ($current_node)."
                node_updated=true
            else
                if [ "${DRY_RUN:-false}" = "true" ]; then
                    log_info "[DRY-RUN] Would install Node.js LTS ($remote_lts via nvm)..."
                    node_updated=true
                else
                    log_action "Updating Node.js via nvm (${current_node:-none} -> $remote_lts)..."
                    if nvm install --lts --reinstall-packages-from=current 2>/dev/null || nvm install --lts 2>/dev/null; then
                        nvm alias default 'lts/*' 2>/dev/null || true
                        nvm use --silent default 2>/dev/null || true
                        log_ok "Node.js updated to $(node -v 2>/dev/null || echo "$remote_lts")."
                        node_updated=true
                    else
                        log_warn "Failed to update Node.js via nvm."
                    fi
                fi
            fi
        fi
    fi

    if [ "$node_updated" = "false" ]; then
        if command -v node &>/dev/null; then
            log_ok "Node.js active ($(node -v))."
        else
            log_bootstrap "Installing Node.js via DNF..."
            if run_or_dry sudo dnf install -y nodejs npm 2>/dev/null; then
                command -v node &>/dev/null && log_ok "Node.js installed ($(node -v))." || log_warn "Node.js installation could not be verified."
            else
                log_warn "Failed to install Node.js via DNF."
            fi
        fi
    fi

    # 5. NPM Global Prefix & Tools
    step "Core: NPM Global Configuration & Tools"
    if command -v npm &>/dev/null; then
        local npm_prefix; npm_prefix="$(npm config get prefix 2>/dev/null || true)"
        if [ "$npm_prefix" = "/usr" ] || [ "$npm_prefix" = "/usr/local" ] || [ -z "$npm_prefix" ]; then
            log_bootstrap "Configuring user npm prefix → $HOME/.npm-global"
            mkdir -p "$HOME/.npm-global/bin" "$HOME/.npm-global/lib"
            npm config set prefix "$HOME/.npm-global"; export PATH="$HOME/.npm-global/bin:$PATH"
        fi
        local npm_outdated; npm_outdated="$(npm outdated -g --json 2>/dev/null || true)"
        if [ -n "$npm_outdated" ] && [ "$npm_outdated" != "{}" ]; then
            log_action "Updating outdated global NPM packages..."
            npm update -g 2>/dev/null || true
            log_ok "NPM global packages updated."
        else
            log_ok "NPM global config synced (all packages current)."
        fi
        _NPM_GLOBAL_SYNCED=true
    fi

    # 6. Python CLI Tools (uv tool / pip)
    step "Core: Python CLI Utilities Suite"
    local cli_tools=( esptool meshtastic openai-whisper mcp rich-click tabulate pyinstaller uvicorn websockets )
    local user_libs=( google-antigravity google-genai setuptools )
    local total_tools="${#cli_tools[@]}" tidx=0
    if command -v uv &>/dev/null; then
        log_action "Checking and upgrading uv-managed CLI tools..."
        uv tool upgrade --all 2>/dev/null || true
        local installed_tools; installed_tools="$(uv tool list --color never 2>/dev/null || true)"
        for tool in "${cli_tools[@]}"; do
            ((tidx++))
            if ! echo "$installed_tools" | grep -q "^$tool "; then
                log_substep "$tidx" "$total_tools" "Installing missing $tool via uv..."
                uv tool install --force "$tool" 2>/dev/null || true
            fi
        done
        log_action "Verifying user Python libraries (${user_libs[*]})..."
        python3 -m pip install --user --upgrade "${user_libs[@]}" 2>&1 | while IFS= read -r pline; do
            case "$pline" in
                *"Successfully installed"*|*"Downloading"*)
                    echo -e "  ${CYAN}--> $pline${RESET}" ;;
                *) ;;
            esac
        done
        log_ok "Python CLI utilities synchronized."
    elif python3 -c "import pip" &>/dev/null; then
        log_action "Checking Python CLI tools via pip..."
        for tool in "${cli_tools[@]}" "${user_libs[@]}"; do
            ((tidx++)); log_substep "$tidx" "$((total_tools + ${#user_libs[@]}))" "Verifying $tool..."
            python3 -m pip install --user --upgrade "$tool" 2>/dev/null || true
        done
        log_ok "Python CLI utilities synced via pip."
    fi

    # 7. Micro Editor
    step "Core: Micro Editor"
    if ! command -v micro &>/dev/null; then
        log_bootstrap "Installing Micro editor..."
        sudo dnf install -y micro 2>/dev/null || (curl https://getmic.ro | bash && mv micro "$HOME/.local/bin/") 2>/dev/null || true
    fi
    command -v micro &>/dev/null && { micro -plugin update 2>/dev/null || true; log_ok "Micro editor + plugins up to date."; }

    # 8. GitHub CLI (gh)
    step "Core: GitHub CLI (gh)"
