                log_ok "Claude Code updated."
            fi
        else
            log_action "Checking Claude Code version..."
            claude update || log_warn "Claude update had issues, continuing..."
        fi
    else skip_step "Claude Code CLI" "not installed"; fi

    # LM Studio
    if command -v lms &>/dev/null; then
        step "AI: LM Studio Runtime Extensions"
        log_action "Checking LM Studio runtimes..."
        lms runtime update -y --all || log_warn "LM Studio update had issues, continuing..."
    else skip_step "LM Studio" "not installed"; fi

    # Ollama
    if command -v ollama &>/dev/null; then
        step "AI: Ollama Engine & Installed Models"
        local cv lv
        cv="$(ollama --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)"
        log_action "Checking Ollama version (current: ${cv:-unknown})..."
        lv="$(curl -s --max-time 4 'https://api.github.com/repos/ollama/ollama/releases/latest' 2>/dev/null | grep -o '"tag_name": *"[^"]*"' | head -n 1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true)"
        if [ -n "$cv" ] && [ -n "$lv" ] && [ "$cv" = "$lv" ]; then
            log_ok "Ollama up to date ($cv)."
        elif [ -n "$lv" ]; then
            if [ "${DRY_RUN:-false}" = "true" ]; then
                log_info "[DRY-RUN] Would upgrade Ollama ($cv -> $lv)"
            else
                log_info "Upgrading Ollama ($cv -> $lv, downloading installer bundle)..."
                curl -fsSL https://ollama.com/install.sh | sh || log_warn "Ollama update failed, continuing..."
                log_action "Waiting for Ollama daemon to initialize..."
                for _i in {1..10}; do ollama list &>/dev/null && break || sleep 1; done
            fi
        fi
        local ollama_list
        if ollama_list="$(ollama list 2>/dev/null)"; then
            local models; models="$(echo "$ollama_list" | tail -n +2 | awk '{print $1}' | grep -v '^$' || true)"
            if [ -n "$models" ]; then
                local model_arr=()
                while IFS= read -r m; do [ -n "$m" ] && model_arr+=("$m"); done <<< "$models"
                local total="${#model_arr[@]}"
                if [ "$total" -eq 0 ]; then
                    log_ok "No local Ollama models installed."
                else
                    local midx=0; log_info "Updating $total installed Ollama models..."
                    for model in "${model_arr[@]}"; do
                        ((midx++)); log_substep "$midx" "$total" "Pulling $model..."
                        ollama pull "$model" || log_warn "Failed to pull '$model', continuing..."
                    done
                    log_ok "All Ollama models updated."
                fi
            else
                log_ok "No local Ollama models installed."
            fi
        else
            log_warn "Ollama not running; skipping model updates."
        fi
    else skip_step "Ollama Engine" "not installed"; fi
}

