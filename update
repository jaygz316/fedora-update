#!/usr/bin/env bash
#
# update: Standalone 1-click routine system update & toolchain sync utility
# Location: ~/.local/bin/update or ~/projects/update/fedora-update/update
#

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$SCRIPT_DIR/bin/fedora-update" ]; then
    exec "$SCRIPT_DIR/bin/fedora-update" "$@"
elif [ -f "$HOME/projects/update/fedora-update/bin/fedora-update" ]; then
    exec "$HOME/projects/update/fedora-update/bin/fedora-update" "$@"
else
    echo "Error: fedora-update engine not found." >&2
    exit 1
fi
