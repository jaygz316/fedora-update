    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        local c; c="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
        [[ "$c" == *"chrome-native-host"* ]] && continue
