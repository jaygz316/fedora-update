is_android_studio_running()      { [ -n "$(get_android_studio_pids)" ]; }
is_antigravity_desktop_running() { [ -n "$(get_antigravity_desktop_pids)" ]; }
is_antigravity_ide_running()     { [ -n "$(get_antigravity_ide_pids)" ]; }
