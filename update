    with urllib.request.urlopen(p_req, timeout=5) as p_resp:
        p_html = p_resp.read().decode("utf-8", errors="ignore")
    m_url = re.search(r"data-category=[\x22\x27]canary_linux_bundle_download[\x22\x27][^>]*href=[\x22\x27](https://[^\s\x22\x27]+)[\x22\x27]", p_html)
