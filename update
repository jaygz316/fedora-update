#!/usr/bin/env bash
# update — Fedora Fleet Maintenance & Toolchain Sync Suite
#
# Keeps a fleet of Fedora machines fully updated with one command.
# Synced across machines via Syncthing (~/.gemini, ~/projects/).
#
# Usage: update [OPTIONS]
#   --trim           Also perform SSD TRIM (fstrim -av)
#   --only=MODULE    Run only one section: core|dnf|flatpak|firmware|ai|dev|git|self|cleanup
#   --skip=MODULES   Skip sections; comma-separated or repeated flag
#   --dry-run, -n    Preview steps without making system changes
#   -h, --help       Show this help
#
# Run order: core -> dnf -> flatpak -> firmware -> ai -> dev -> git -> self -> cleanup

set -u

###############################################################################
# PATH — all user toolchain binaries available on any node
###############################################################################
for _dir in \
    "$HOME/.local/bin" "$HOME/bin" "$HOME/.cargo/bin" "$HOME/.bun/bin" \
    "$HOME/.npm-global/bin" "$HOME/.lmstudio/bin" "$HOME/google-cloud-sdk/bin" \
    "$HOME/go/bin" "$HOME/Android/Sdk/cmdline-tools/latest/bin" \
    "$HOME/Android/Sdk/platform-tools" "$HOME/Android/Sdk/emulator" \
    "$HOME/.local/opt/android-studio-preview/bin"
do
    [ -d "$_dir" ] && [[ ":$PATH:" != *":$_dir:"* ]] && PATH="$_dir:$PATH"
done
export PATH
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env" 2>/dev/null || true

###############################################################################
# COLORS & ENVIRONMENT
###############################################################################
BOLD="\033[1m"; GREEN="\033[0;32m"; YELLOW="\033[0;33m"
RED="\033[0;31m"; CYAN="\033[0;36m"; MAGENTA="\033[0;35m"; RESET="\033[0m"
export PYTHONUNBUFFERED=1 GIT_TERMINAL_PROMPT=0 FORCE_COLOR=1 CLICOLOR_FORCE=1

###############################################################################
# STEP COUNTER & LOGGING HELPERS
###############################################################################
STEP_COUNT=0; TOTAL_STEPS=0

step() {
    STEP_COUNT=$((STEP_COUNT + 1))
    [ "$TOTAL_STEPS" -gt 0 ] \
        && echo -e "\n${BOLD}${GREEN}[+] [${STEP_COUNT}/${TOTAL_STEPS}] $1...${RESET}" \
        || echo -e "\n${BOLD}${GREEN}[+] [${STEP_COUNT}] $1...${RESET}"
}
skip_step() {
    STEP_COUNT=$((STEP_COUNT + 1))
    local title="$1" reason="${2:-not found}"
    [ "$TOTAL_STEPS" -gt 0 ] \
        && echo -e "\n${YELLOW}[-] [${STEP_COUNT}/${TOTAL_STEPS}] ${title} (${reason}, skipping)${RESET}" \
        || echo -e "\n${YELLOW}[-] [${STEP_COUNT}] ${title} (${reason}, skipping)${RESET}"
}
log_substep()  { echo -e "  ${BOLD}${CYAN}--> [$1/$2]${RESET} $3"; }
log_action()   { echo -e "  ${CYAN}... $1${RESET}"; }
log_info()     { echo -e "  ${BOLD}[*] $1${RESET}"; }
log_ok()       { echo -e "  ${GREEN}[OK] $1${RESET}"; }
log_warn()     { echo -e "  ${YELLOW}^ WARNING: $1${RESET}"; }
log_err()      { echo -e "  ${RED}^ ERROR: $1${RESET}"; }
log_bootstrap(){ echo -e "  ${BOLD}${MAGENTA}--> [BOOTSTRAP] $1${RESET}"; }

# Execute a command, or in --dry-run mode just print it without running
run_or_dry() {
    if [ "${DRY_RUN:-false}" = "true" ]; then
        echo -e "  ${MAGENTA}[DRY-RUN] Would run: $*${RESET}"; return 0
    fi
    "$@"
}

###############################################################################
# LOGGING — tee to timestamped log + ~/.local/state/update/last-update.log
###############################################################################
init_logging() {
    local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/update"
    mkdir -p "$log_dir"
    LOG_FILE="$log_dir/update_$(date +%Y%m%d_%H%M%S).log"
    find "$log_dir" -name "update_*.log" -type f 2>/dev/null | sort -r | tail -n +11 | xargs -r rm -f
    exec > >(tee -a "$LOG_FILE" | tee "$log_dir/last-update.log") 2>&1
}

###############################################################################
# PASSWORDLESS SUDO & POLKIT AUTO-SETUP
###############################################################################
ensure_passwordless_sudo() {
    ! command -v sudo &>/dev/null && { log_warn "'sudo' not found."; return 0; }
    local sudoers_file="/etc/sudoers.d/$USER"
    local polkit_rule="/etc/polkit-1/rules.d/49-nopasswd-fedora-update.rules"

    _write_polkit_rule() {
        [ -d "/etc/polkit-1/rules.d" ] && [ ! -f "$polkit_rule" ] || return 0
        sudo tee "$polkit_rule" >/dev/null <<EOF
polkit.addRule(function(action, subject) {
    if (subject.user == "$USER" || subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
EOF
        sudo chmod 0644 "$polkit_rule" 2>/dev/null || true
    }

    if sudo -n true 2>/dev/null; then
        _write_polkit_rule
        log_ok "Passwordless sudo & Polkit verified."
    else
        echo -e "\n${BOLD}${CYAN}------------------------------------------------------------${RESET}"
        echo -e "${CYAN}  Configuring passwordless sudo for 1-click runs...${RESET}"
        echo -e "${BOLD}${CYAN}------------------------------------------------------------${RESET}"
        if [ -t 0 ] || [ -e /dev/tty ]; then
            if sudo -v; then
                echo "$USER ALL=(ALL:ALL) NOPASSWD: ALL" | sudo tee "$sudoers_file" >/dev/null
                sudo chmod 0440 "$sudoers_file"; sudo chown root:root "$sudoers_file" 2>/dev/null || true
                _write_polkit_rule
                sudo -n true 2>/dev/null \
                    && log_ok "Passwordless sudo configured for $USER." \
                    || log_warn "Configured rules but validation returned non-zero."
            else
                log_warn "Authentication failed. Privileged operations may prompt."
            fi
        else
            log_warn "Non-interactive session. Run 'update' in a terminal once to finish setup."
        fi
    fi

    # Keep sudo ticket alive for the duration of the run
    if sudo -n true 2>/dev/null; then
        while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &
        local _sudo_pid=$!
        trap 'kill "$_sudo_pid" 2>/dev/null || true' EXIT
    fi
}

###############################################################################
# PROCESS DETECTION — protect running apps/agents from being updated mid-session
###############################################################################
_is_process_excluded() {
    local pid="$1"
    { [ "$pid" = "$$" ] || [ "$pid" = "${PPID:-0}" ] || [ "$pid" = "${BASHPID:-$$}" ]; } && return 0
    local comm; comm=$(ps -p "$pid" -o comm= 2>/dev/null || true)
    case "$comm" in pgrep|grep|bash|sh|zsh) return 0 ;; esac
    local cmdline; cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
    [[ "$cmdline" == *"telemetry_hook_bundle.js"* || "$cmdline" == *"fedora-update"* ]] && return 0
    return 1
}
_pids_running() {
    # Returns 0 if any non-excluded pid from pgrep output is running
    local pids="$1"
    [ -z "$pids" ] && return 1
    for pid in $pids; do _is_process_excluded "$pid" || return 0; done
    return 1
}
is_process_exact_running() { _pids_running "$(pgrep -x "$1" 2>/dev/null || true)"; }
is_vscode_running()          { is_process_exact_running "code"; }
is_antigravity_ide_running() { is_process_exact_running "antigravity-ide"; }
is_android_studio_running() {
    local pids; pids="$(pgrep -f 'com.intellij.idea.Main|/android-studio' 2>/dev/null || true)"
    [ -z "$pids" ] && { is_process_exact_running "studio.sh" || is_process_exact_running "studio64"; return; }
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        local c; c=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
        [[ "$c" == *"android-studio"* || "$c" == *"com.intellij.idea.Main"* ]] && return 0
    done; return 1
}
is_antigravity_desktop_running() {
    local pids; pids="$(pgrep -x antigravity 2>/dev/null || true)"
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        local c; c=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
        [[ "$c" == *"/opt/antigravity/antigravity"* && "$c" != *"antigravity-cli"* && "$c" != *"antigravity-ide"* ]] && return 0
    done; return 1
}
is_cli_running() {
    local name="$1"
    local pids; pids="$(pgrep -x "$name" 2>/dev/null || true)"
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        [ "$name" = "herdr" ] && { local c; c=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true); [[ "$c" == *"server"* ]] && continue; }
        return 0
    done; return 1
}

###############################################################################
# GIT GUARD — Syncthing-safe git pull (skips on dirty working tree)
###############################################################################
safe_git_repo_update() {
    local repo_path="$1"
    local repo_name; repo_name="$(basename "$repo_path")"
    [ ! -d "$repo_path" ] && { log_warn "$repo_name not found, skipping."; return 0; }
    (
        cd "$repo_path" || return 1
        git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { log_warn "$repo_name is not a git repo."; return 1; }
        log_action "Inspecting $repo_name..."
        export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15"
        local dirty; dirty="$(git status --porcelain 2>/dev/null || true)"
        if [ -n "$dirty" ]; then
            echo -e "  ${YELLOW}[SKIP] Local changes in $repo_name; skipping pull to avoid Syncthing conflicts.${RESET}"
            return 0
        fi
        log_action "Fetching upstream for $repo_name..."
        timeout 45s git fetch --all --prune 2>/dev/null || { log_warn "Fetch timed out for $repo_name."; return 0; }
        local local_c upstream_c
        local_c="$(git rev-parse HEAD 2>/dev/null || true)"
        upstream_c="$(git rev-parse '@{u}' 2>/dev/null || true)"
        if [ -n "$local_c" ] && [ -n "$upstream_c" ] && [ "$local_c" = "$upstream_c" ]; then
            log_ok "$repo_name is already up to date."
        else
            timeout 60s git pull --rebase --autostash \
                && log_ok "$repo_name synchronized." \
                || log_warn "Pull/rebase failed for $repo_name."
        fi
    ) || log_warn "Git operation failed on $repo_path"
}

###############################################################################
# SECTION: CORE FLEET BASELINE
# Guaranteed on every node. Installs if missing, updates if present.
###############################################################################
_update_or_install_go_tool() {
    local bin_name="$1" install_path="$2"
    local bin_path="$HOME/go/bin/$bin_name"
    if [ -x "$bin_path" ]; then
        local mod_line mod_path current_ver latest_ver
        mod_line="$(go version -m "$bin_path" 2>/dev/null | grep -E "^\s*mod\s+" | head -n 1)"
        mod_path="$(echo "$mod_line" | awk '{print $2}')"
        current_ver="$(echo "$mod_line" | awk '{print $3}')"
        if [ -n "$mod_path" ]; then
            latest_ver="$(curl -s --max-time 3 "https://proxy.golang.org/$mod_path/@latest" 2>/dev/null | grep -o '"Version":"[^"]*"' | cut -d'"' -f4 || true)"
        fi
        if [ -n "$current_ver" ] && [ -n "$latest_ver" ] && [ "$current_ver" = "$latest_ver" ]; then
            log_ok "$bin_name already up to date ($current_ver)."; return 0
        fi
    fi
    log_info "Installing/updating $bin_name..."
    go install "$install_path@latest"
}

run_core_baseline() {
    echo -e "\n${BOLD}${CYAN}============================================================${RESET}"
    echo -e "${BOLD}${CYAN}   Core Fleet Baseline: Verifying & Updating Essentials    ${RESET}"
    echo -e "${BOLD}${CYAN}============================================================${RESET}"

    local arch; arch=$(uname -m)   # shared by Antigravity Desktop + IDE steps below

    # 1. C/C++ Build Tools
    step "Core: C/C++ Build Toolchain (gcc, make, pkgconf)"
    if ! command -v gcc &>/dev/null || ! command -v make &>/dev/null; then
        log_bootstrap "Installing gcc, gcc-c++, make, pkgconf..."
        sudo dnf install -y gcc gcc-c++ make pkgconf-pkg-config 2>/dev/null || true
    fi
    command -v gcc &>/dev/null && log_ok "C/C++ build tools verified."

    # 2. Python & pip
    step "Core: Python 3 & pip"
    if ! python3 -c "import pip" &>/dev/null; then
        log_bootstrap "Installing python3-pip..."
        sudo dnf install -y python3-pip || python3 -m ensurepip --user || true
    fi
    python3 -c "import pip" &>/dev/null \
        && { python3 -m pip install --user --upgrade pip 2>/dev/null || true; log_ok "pip up to date."; } \
        || log_warn "pip installation could not be completed."

    # 3. Astral uv
    step "Core: Astral uv package manager"
    if ! command -v uv &>/dev/null; then
        log_bootstrap "Installing Astral uv..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
        export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    else
        uv self update 2>/dev/null || true; log_ok "uv up to date."
    fi

    # 4. NPM Global Prefix & Tools
    step "Core: NPM Global Configuration & Tools"
    if command -v npm &>/dev/null; then
        local npm_prefix; npm_prefix="$(npm config get prefix 2>/dev/null || true)"
        if [ "$npm_prefix" = "/usr" ] || [ "$npm_prefix" = "/usr/local" ] || [ -z "$npm_prefix" ]; then
            log_bootstrap "Configuring user npm prefix → $HOME/.npm-global"
            mkdir -p "$HOME/.npm-global/bin" "$HOME/.npm-global/lib"
            npm config set prefix "$HOME/.npm-global"; export PATH="$HOME/.npm-global/bin:$PATH"
        fi
        npm update -g 2>/dev/null || true
        log_ok "NPM global config synced."
    fi

    # 5. Python CLI Tools (uv tool / pip)
    step "Core: Python CLI Utilities Suite"
    local cli_tools=( esptool meshtastic openai-whisper mcp rich-click tabulate pyinstaller uvicorn websockets )
    local user_libs=( google-antigravity google-genai setuptools )
    local total_tools="${#cli_tools[@]}" tidx=0
    if command -v uv &>/dev/null; then
        uv tool upgrade --all 2>/dev/null || true
        for tool in "${cli_tools[@]}"; do
            ((tidx++)); log_substep "$tidx" "$total_tools" "Verifying $tool..."
            uv tool install --upgrade "$tool" 2>/dev/null || true
        done
        python3 -m pip install --user --upgrade "${user_libs[@]}" 2>/dev/null || true
        uv cache prune 2>/dev/null || true
        log_ok "Python CLI utilities synchronized."
    elif python3 -c "import pip" &>/dev/null; then
        for tool in "${cli_tools[@]}" "${user_libs[@]}"; do
            ((tidx++)); log_substep "$tidx" "$((total_tools + ${#user_libs[@]}))" "Verifying $tool..."
            python3 -m pip install --user --upgrade "$tool" 2>/dev/null || true
        done
        log_ok "Python CLI utilities synced via pip."
    fi

    # 6. Micro Editor
    step "Core: Micro Editor"
    if ! command -v micro &>/dev/null; then
        log_bootstrap "Installing Micro editor..."
        sudo dnf install -y micro 2>/dev/null || (curl https://getmic.ro | bash && mv micro "$HOME/.local/bin/") 2>/dev/null || true
    fi
    command -v micro &>/dev/null && { micro -plugin update 2>/dev/null || true; log_ok "Micro editor + plugins up to date."; }

    # 7. GitHub CLI (gh)
    step "Core: GitHub CLI (gh)"
    ! command -v gh &>/dev/null && { log_bootstrap "Installing GitHub CLI..."; sudo dnf install -y gh 2>/dev/null || true; }
    command -v gh &>/dev/null && {
        gh auth status &>/dev/null && gh extension upgrade --all 2>/dev/null || true
        log_ok "GitHub CLI ready."
    }

    # 8. Rust (rustup) + cargo tools
    step "Core: Rust Toolchain & Cargo Tools (rustup)"
    if ! command -v rustup &>/dev/null && [ ! -f "$HOME/.cargo/bin/rustup" ]; then
        log_bootstrap "Installing Rustup..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
        [ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
        export PATH="$HOME/.cargo/bin:$PATH"
    fi
    if command -v rustup &>/dev/null || [ -x "$HOME/.cargo/bin/rustup" ]; then
        [ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
        rustup update || true
        if [ -x "$HOME/.cargo/bin/cargo-tauri" ]; then
            local current_tauri latest_tauri
            current_tauri="$(cargo tauri --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)"
            latest_tauri="$(curl -s --max-time 5 'https://crates.io/api/v1/crates/tauri-cli' 2>/dev/null | grep -o '"max_version":"[^"]*"' | cut -d'"' -f4 || true)"
            if [ -n "$current_tauri" ] && [ -n "$latest_tauri" ] && [ "$current_tauri" = "$latest_tauri" ]; then
                log_ok "tauri-cli already up to date ($current_tauri)."
            else
                log_action "Updating tauri-cli (${current_tauri:-unknown} -> $latest_tauri)..."
                cargo install tauri-cli --locked 2>/dev/null || true
            fi
        fi
        log_ok "Rust toolchain up to date."
    fi

    # 9. Bun Runtime
    step "Core: Bun JavaScript/TypeScript Runtime"
    if ! command -v bun &>/dev/null; then
        log_bootstrap "Installing Bun..."; curl -fsSL https://bun.sh/install | bash; export PATH="$HOME/.bun/bin:$PATH"
    else
        bun upgrade 2>/dev/null || true; log_ok "Bun up to date."
    fi

    # 10. Go + tooling (gopls, dlv)
    step "Core: Go Compiler & Developer Tooling"
    ! command -v go &>/dev/null && { log_bootstrap "Installing Go via DNF..."; sudo dnf install -y golang 2>/dev/null || true; }
    command -v go &>/dev/null && {
        _update_or_install_go_tool "gopls" "golang.org/x/tools/gopls" || true
        _update_or_install_go_tool "dlv"   "github.com/go-delve/delve/cmd/dlv" || true
        log_ok "Go tooling verified."
    }

    # 11. Docker Engine & Compose
    step "Core: Docker Engine & Docker Compose"
    if ! command -v docker &>/dev/null; then
        log_bootstrap "Installing Docker CE + Compose plugin..."
        sudo dnf -y install dnf-plugins-core 2>/dev/null || true
        sudo dnf config-manager --add-repo https://download.docker.com/linux/fedora/docker-ce.repo 2>/dev/null || \
            sudo dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo 2>/dev/null || true
        sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin 2>/dev/null || true
        sudo systemctl enable --now docker 2>/dev/null || true
        sudo usermod -aG docker "$USER" 2>/dev/null || true
        log_ok "Docker installed and service activated."
    else
        systemctl is-active --quiet docker 2>/dev/null || sudo systemctl enable --now docker 2>/dev/null || true
        log_ok "Docker Engine active."
    fi

    # 12. Android CLI & SDK
    step "Core: Android CLI & SDK Tools"
    local android_sdk_dir="$HOME/Android/Sdk"
    if ! command -v android &>/dev/null && [ ! -d "$android_sdk_dir/cmdline-tools" ]; then
        log_bootstrap "Installing Android SDK Command-line Tools..."
        mkdir -p "$android_sdk_dir/cmdline-tools"
        local tmp_cmdline
        tmp_cmdline="$(mktemp -d -t android-cmdline-XXXXXX)"
        if curl -# -fSL -o "$tmp_cmdline/cmdline.zip" \
            "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" 2>/dev/null; then
            unzip -q "$tmp_cmdline/cmdline.zip" -d "$tmp_cmdline"
            rm -rf "$android_sdk_dir/cmdline-tools/latest"
            mv "$tmp_cmdline/cmdline-tools" "$android_sdk_dir/cmdline-tools/latest"
            mkdir -p "$HOME/.local/bin"
            cat << 'WRAPPER' > "$HOME/.local/bin/android"
#!/usr/bin/env bash
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_SDK_ROOT="$HOME/Android/Sdk"
exec "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "$@"
WRAPPER
            chmod +x "$HOME/.local/bin/android"
            log_ok "Android SDK Command-line Tools installed."
        else
            log_warn "Failed to download Android commandlinetools."
        fi
        rm -rf "$tmp_cmdline"
    elif command -v android &>/dev/null; then
        android update 2>/dev/null || true; log_ok "Android CLI up to date."
    fi

    # 13. Android Studio Preview
    step "Core: Android Studio Latest Preview"
    local studio_preview_dir="$HOME/.local/opt/android-studio-preview"
    if is_android_studio_running; then
        echo -e "  ${YELLOW}[SKIP] Android Studio is running; skipping update.${RESET}"
    elif [ ! -d "$studio_preview_dir" ] && [ ! -f "$HOME/.local/bin/android-studio-preview" ]; then
        log_bootstrap "Setting up Android Studio Preview launchers..."
        mkdir -p "$studio_preview_dir" "$HOME/.local/share/applications" "$HOME/.local/bin"
        cat << DESKTOP > "$HOME/.local/share/applications/android-studio-preview.desktop"
[Desktop Entry]
Name=Android Studio Preview
Exec=$studio_preview_dir/bin/studio.sh
Icon=$studio_preview_dir/bin/studio.png
Type=Application
Terminal=false
Categories=Development;IDE;
DESKTOP
        cat << WRAPPER > "$HOME/.local/bin/android-studio-preview"
#!/usr/bin/env bash
exec "$studio_preview_dir/bin/studio.sh" "\$@"
WRAPPER
        chmod +x "$HOME/.local/bin/android-studio-preview"
        log_ok "Android Studio Preview launchers registered."
    else
        log_ok "Android Studio Preview verified."
    fi

    # 14. Google Antigravity Desktop
    step "Core: Google Antigravity Desktop"
    local antigravity_dir="$HOME/.local/opt/antigravity"
    if is_antigravity_desktop_running; then
        echo -e "  ${YELLOW}[SKIP] Antigravity Desktop is active; skipping update.${RESET}"
    else
        local arch_dir=""
        case "$arch" in x86_64|amd64) arch_dir="linux-x64" ;; aarch64|arm64) arch_dir="linux-arm64" ;;
            *) log_warn "Unsupported arch for Antigravity Desktop: $arch" ;;
        esac
        if [ -n "$arch_dir" ]; then
            local manifest_data; manifest_data="$(curl -s --max-time 5 \
                'https://antigravity-hub-auto-updater-974169037036.us-central1.run.app/manifest/latest-x64-linux.yml' \
                2>/dev/null || true)"
            local current_ver=""; [ -f "$antigravity_dir/.version" ] && current_ver="$(cat "$antigravity_dir/.version" 2>/dev/null || true)"
            local latest_ver; latest_ver="$(echo "$manifest_data" | grep -E '^version:' | awk '{print $2}' || true)"
            if [ -n "$current_ver" ] && [ -n "$latest_ver" ] && [ "$current_ver" = "$latest_ver" ]; then
                log_ok "Antigravity Desktop up to date ($current_ver)."
            elif [ -n "$manifest_data" ] && [ -n "$latest_ver" ]; then
                log_info "Updating Antigravity Desktop (${current_ver:-none} -> $latest_ver)..."
                local base_url; base_url="$(echo "$manifest_data" | grep -o 'https://storage.googleapis.com/antigravity-public/antigravity-hub/[^/]*' | head -n 1)"
                local tmp_w; tmp_w="$(mktemp -d -t antigravity-update-XXXXXX)"
                if curl -# -fSL -o "$tmp_w/Antigravity.tar.gz" "${base_url}/${arch_dir}/Antigravity.tar.gz" 2>/dev/null; then
                    mkdir -p "$tmp_w/x"; tar -xzf "$tmp_w/Antigravity.tar.gz" -C "$tmp_w/x"
                    local pd; pd="$(find "$tmp_w/x" -mindepth 1 -maxdepth 1 -type d | head -n 1)"; [ -z "$pd" ] && pd="$tmp_w/x"
                    if [ -f "$pd/antigravity" ]; then
                        rm -rf "$antigravity_dir"; mkdir -p "$antigravity_dir"; mv "$pd"/* "$antigravity_dir/"
                        chmod +x "$antigravity_dir/antigravity"; echo "$latest_ver" > "$antigravity_dir/.version"
                        mkdir -p "$HOME/.local/share/applications" "$HOME/Desktop" "$HOME/.local/bin"
                        cat << DESKTOP > "$HOME/.local/share/applications/antigravity.desktop"
[Desktop Entry]
Name=Antigravity
Exec=$antigravity_dir/antigravity --no-sandbox
Icon=$antigravity_dir/icon.png
Type=Application
Terminal=false
Categories=Development;IDE;
DESKTOP
