                    proceed=false
                else
                    was_running=true
                fi
            fi

            if [ "$proceed" = "true" ]; then
                if [ "${DRY_RUN:-false}" = "true" ]; then
                    log_info "[DRY-RUN] Would update Antigravity IDE (${current_ide:-none} -> $latest_ide)..."
                    _ensure_antigravity_ide_launchers
                    [ "$was_running" = "true" ] && restart_app "Antigravity IDE" "antigravity-ide" "$antigravity_ide_dir/antigravity-ide --no-sandbox"
                else
                    log_info "Updating Antigravity IDE (${current_ide:-none} -> $latest_ide)..."
                    log_action "Downloading Antigravity IDE archive ($latest_ide)..."
                    local tmp_w; tmp_w="$(mktemp -d -t antigravity-ide-update-XXXXXX)"
                    if curl -# -fSL -o "$tmp_w/Antigravity-IDE.tar.gz" "${download_url// /%20}" 2>/dev/null; then
                        log_action "Extracting and installing to $antigravity_ide_dir..."
                        mkdir -p "$tmp_w/x"; tar -xzf "$tmp_w/Antigravity-IDE.tar.gz" -C "$tmp_w/x"
                        local pd; pd="$(find "$tmp_w/x" -mindepth 1 -maxdepth 1 -type d | head -n 1)"; [ -z "$pd" ] && pd="$tmp_w/x"
                        if [ -f "$pd/antigravity-ide" ] || [ -f "$pd/antigravity" ]; then
                            rm -rf "$antigravity_ide_dir"; mkdir -p "$antigravity_ide_dir"; mv "$pd"/* "$antigravity_ide_dir/"
                            [ -f "$antigravity_ide_dir/antigravity-ide" ] && chmod +x "$antigravity_ide_dir/antigravity-ide"
                            [ -f "$antigravity_ide_dir/antigravity" ]     && chmod +x "$antigravity_ide_dir/antigravity"
                            echo "$latest_ide" > "$antigravity_ide_dir/.version"
                            _ensure_antigravity_ide_launchers
                            log_ok "Antigravity IDE updated to $latest_ide."
                            if [ "$was_running" = "true" ]; then
                                restart_app "Antigravity IDE" "antigravity-ide" "$antigravity_ide_dir/antigravity-ide --no-sandbox"
                            fi
                        fi
                    fi
                    rm -rf "$tmp_w"
                fi
            fi
        fi
    fi

    # 17. Agy CLI
    step "Core: Agy CLI"
    if ! command -v agy &>/dev/null; then
        log_bootstrap "Installing Agy CLI..."; npm install -g @google/agy 2>/dev/null || true
    elif is_cli_running "agy"; then
        if [ "${FORCE_UPDATE:-false}" != "true" ]; then
            echo -e "  ${YELLOW}[SKIP] Agy is active; skipping update (use --force to update).${RESET}"
        else
            log_info "Updating Agy CLI (--force)..."
            agy update 2>/dev/null || npm install -g @google/agy 2>/dev/null || true
            log_ok "Agy CLI up to date."
        fi
    else
        agy update 2>/dev/null || true; log_ok "Agy CLI up to date."
    fi

    # 18. Herdr CLI
    step "Core: Herdr CLI"
    if ! command -v herdr &>/dev/null; then
        log_bootstrap "Installing Herdr CLI..."; curl -fsSL https://herdr.dev/install.sh | bash 2>/dev/null || true
    else
        local cv_h; cv_h="$(herdr --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true)"
        local lv_h; lv_h="$(curl -s --max-time 3 'https://herdr.dev/latest.json' 2>/dev/null | grep -m1 '"version":' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true)"
        if [ -n "$cv_h" ] && [ -n "$lv_h" ] && [ "$cv_h" = "$lv_h" ]; then
            log_ok "Herdr up to date ($cv_h)."
        elif is_cli_running "herdr"; then
            if [ "${FORCE_UPDATE:-false}" != "true" ]; then
                echo -e "  ${YELLOW}[SKIP] Herdr is active; skipping update (use --force to update).${RESET}"
            else
                log_info "Updating Herdr CLI with session handoff (--force)..."
                herdr update --handoff 2>/dev/null || herdr update 2>/dev/null || true
                log_ok "Herdr updated to ${lv_h:-latest}."
            fi
        else
            log_info "Updating Herdr CLI..."; herdr update 2>/dev/null || true
            log_ok "Herdr updated to ${lv_h:-latest}."
        fi
    fi

    # 19. Syncthing
    step "Core: Syncthing Sync Engine"
    ! command -v syncthing &>/dev/null && { log_bootstrap "Installing Syncthing..."; sudo dnf install -y syncthing 2>/dev/null || true; }
    if command -v syncthing &>/dev/null; then
        local st_configs=( "$HOME/.local/state/syncthing/config.xml" "$HOME/.config/syncthing/config.xml" )
        local st_cfg=""
        for c in "${st_configs[@]}"; do [ -f "$c" ] && { st_cfg="$c"; break; }; done
        if [ -z "$st_cfg" ]; then
            log_bootstrap "Generating initial Syncthing config..."
            syncthing generate 2>/dev/null || syncthing --generate 2>/dev/null || true
            for c in "${st_configs[@]}"; do [ -f "$c" ] && { st_cfg="$c"; break; }; done
        fi
        [ -n "$st_cfg" ] && grep -q "<address>127.0.0.1:8384</address>" "$st_cfg" && \
            sed -i 's|<address>127.0.0.1:8384</address>|<address>0.0.0.0:8384</address>|g' "$st_cfg" && \
            log_info "Syncthing GUI configured → 0.0.0.0:8384"
        if command -v firewall-cmd &>/dev/null && systemctl is-active --quiet firewalld 2>/dev/null; then
            sudo firewall-cmd --add-service=syncthing --permanent >/dev/null 2>&1 || true
            sudo firewall-cmd --add-port=8384/tcp --permanent >/dev/null 2>&1 || true
            sudo firewall-cmd --reload >/dev/null 2>&1 || true
        fi
        systemctl --user is-active --quiet syncthing.service 2>/dev/null || \
            systemctl --user enable --now syncthing.service 2>/dev/null || true
        log_ok "Syncthing running, GUI on 0.0.0.0:8384."
    fi
}

###############################################################################
# SECTION: DNF — OS package upgrades, autoremove, cache clean
###############################################################################
run_system_dnf() {
    ! command -v dnf &>/dev/null && { skip_step "DNF" "not found"; return 0; }

    # Ensure max_parallel_downloads is active across fleet nodes (default is only 3)
    if [ -f /etc/dnf/dnf.conf ] && ! grep -q "^max_parallel_downloads" /etc/dnf/dnf.conf 2>/dev/null; then
        sudo sed -i '/^\[main\]/a max_parallel_downloads=10' /etc/dnf/dnf.conf 2>/dev/null || true
    fi

    step "System: Refreshing and upgrading DNF packages"
    local pkgs_changed=false
    if [ "${DRY_RUN:-false}" = "true" ]; then
        run_or_dry sudo dnf upgrade --refresh -y
    else
        log_action "Refreshing metadata & resolving updates in a single pass..."
        sudo dnf upgrade --refresh -y 2>&1 | while IFS= read -r line; do
            case "$line" in
                *"Upgrading:"*|*"Installing:"*|*"Removing:"*|*"Replacing:"*|*"Replaced:"*)
                    pkgs_changed=true
                    echo -e "  ${CYAN}$line${RESET}" ;;
                *"Total download size"*|*"Downloading Packages"*)
                    echo -e "  ${BOLD}$line${RESET}" ;;
                *"Running transaction"*)
                    log_action "Applying package updates (this may take several minutes if kernel/drivers update)..." ;;
                *"Preparing"*)
                    echo -e "  ${CYAN}... $line${RESET}" ;;
                *"Upgrading "*|*"Installing "*|*"Cleanup "*|*"Reinstalling "*)
                    echo -e "  ${CYAN}-->${RESET} $line" ;;
                *"Running scriptlet"*|*"akmods"*|*"dracut"*)
                    echo -e "  ${YELLOW}--> [system hook] $line${RESET}" ;;
                *"Nothing to do"*|*"Dependencies resolved"*)
                    echo -e "  ${GREEN}$line${RESET}" ;;
                *"Complete!"*)
                    echo -e "  ${GREEN}$line${RESET}" ;;
                *) ;; # suppress uninformative internal lines
            esac
        done
        local dnf_rc=${PIPESTATUS[0]}
        [ "$dnf_rc" -ne 0 ] && log_warn "DNF upgrade had issues (exit $dnf_rc), continuing..."
    fi
    step "System: Removing unused DNF dependencies"
    run_or_dry sudo dnf autoremove -y 2>&1 | grep -E "(Removing:|Freed space|Nothing to do|Complete)" | sed 's/^/  /' || log_warn "DNF autoremove had issues, continuing..."
    step "System: Cleaning DNF package cache"
    run_or_dry sudo dnf clean packages -y || true
    log_ok "DNF complete."
}

###############################################################################
# SECTION: FLATPAK — update apps + runtimes, prune unused
###############################################################################
_check_and_mask_downgraded_flatpaks() {
    local apps; apps="$(flatpak list --app --columns=application,origin,installation 2>/dev/null || true)"
    [ -z "$apps" ] && return 0
    while read -r app origin inst; do
        [ -z "$app" ] || [ -z "$origin" ] && continue
        local masked
        [ "$inst" = "user" ] && masked="$(flatpak mask --user 2>/dev/null || true)" \
                             || masked="$(flatpak mask 2>/dev/null || true)"
        local ld rd lts rts
        ld="$(flatpak info ${inst:+--$inst} "$app" 2>/dev/null | grep -E '^ +Date:' | awk '{print $2, $3}' || true)"
        rd="$(flatpak remote-info "$origin" "app/$app/$(uname -m)/master" 2>/dev/null | grep -E '^ +Date:' | awk '{print $2, $3}' || true)"
        [ -z "$ld" ] || [ -z "$rd" ] && continue
        lts="$(date -d "$ld" +%s 2>/dev/null || echo 0)"; rts="$(date -d "$rd" +%s 2>/dev/null || echo 0)"
        if echo "$masked" | grep -q "$app"; then
            [ "$rts" -gt "$lts" ] && { log_info "Newer $app upstream; unmasking...";
                [ "$inst" = "user" ] && flatpak mask --user --remove "$app" >/dev/null 2>&1 \
                                     || flatpak mask --remove "$app" >/dev/null 2>&1 || true; }
            continue
        fi
        [ "$lts" -gt "$rts" ] && [ "$rts" -gt 0 ] && { log_info "Remote rollback for $app detected; masking...";
            [ "$inst" = "user" ] && flatpak mask --user "$app" >/dev/null 2>&1 \
                                 || flatpak mask "$app" >/dev/null 2>&1 || true; }
    done <<< "$apps"
}

run_flatpak() {
    ! command -v flatpak &>/dev/null && { skip_step "Flatpak" "not found"; return 0; }
    
    # 1. Prune unused FIRST to prevent downloading 100s of MBs of updates for runtimes about to be deleted
    step "Flatpaks: Pruning unused runtimes (pre-update cleanup)"
    log_action "Checking for obsolete or unused Flatpak runtimes..."
    local pruned_out
    if [ "${DRY_RUN:-false}" = "true" ]; then
        run_or_dry flatpak uninstall --unused -y
    else
        pruned_out="$(flatpak uninstall --unused -y 2>&1 || true)"
        if echo "$pruned_out" | grep -q "Uninstall complete"; then
            local count; count="$(echo "$pruned_out" | grep -c "Uninstalling" || true)"
            log_ok "Pruned $count unused runtime(s) before download."
        else
            log_ok "No unused Flatpak runtimes found."
        fi
    fi

    # 2. Update remaining applications and runtimes
    step "Flatpaks: Updating applications and runtimes"
    _check_and_mask_downgraded_flatpaks 2>/dev/null || true
    log_action "Checking remotes for application and runtime updates..."
    run_or_dry flatpak update -y || { log_warn "Flatpak update had issues; trying --no-static-deltas..."; run_or_dry flatpak update --no-static-deltas -y || true; }
    
    # Quick sweep if an application upgrade left an older runtime orphaned
    if [ "${DRY_RUN:-false}" != "true" ]; then
        flatpak uninstall --unused -y >/dev/null 2>&1 || true
    fi
    log_ok "Flatpaks updated."
}

