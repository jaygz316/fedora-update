    local pids; pids="$(pgrep -x antigravity 2>/dev/null || true)"
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        local c; c=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
        [[ ("$c" == *"/opt/antigravity/antigravity"* || "$c" == *"/.local/opt/antigravity/antigravity"*) && "$c" != *"antigravity-cli"* && "$c" != *"antigravity-ide"* ]] && valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

get_antigravity_ide_pids() {
