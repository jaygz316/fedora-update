        case "$c" in
            *"--service"*|*"--server"*|*"--tray"*|*"--check-hwcodec-config"*) continue ;;
        esac
        [ -n "$c" ] && valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

get_nvbroadcast_pids() {
    local pids; pids="$(pgrep -f '^/opt/nvbroadcast/\.venv/bin/python' 2>/dev/null || true; pgrep -x nvbroadcast 2>/dev/null || true)"
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

get_openlogi_pids() {
    local pids; pids="$(pgrep -x openlogi-desktop 2>/dev/null || true)"
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
