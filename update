#!/usr/bin/env bash
# update — Fedora Fleet Maintenance & Toolchain Sync Suite
#
# Keeps a fleet of Fedora machines fully updated with one command.
# Synced across machines via Syncthing (~/.gemini, ~/projects/).
#
# Usage: update [OPTIONS]
#   --force, -f      Close running apps to apply updates, then restart them
#   --trim           Also perform SSD TRIM (fstrim -av)
#   --only=MODULE    Run only one section: core|dnf|flatpak|snap|firmware|ai|dev|git|self|cleanup
#   --skip=MODULES   Skip sections; comma-separated or repeated flag
#   --dry-run, -n    Preview steps without making system changes
#   -h, --help       Show this help
#
# Run order: core -> dnf -> flatpak -> snap -> firmware -> ai -> dev -> git -> self -> cleanup

set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
[ -z "$SCRIPT_PATH" ] && SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ARCH="$(uname -m)"

###############################################################################
# PATH — all user toolchain binaries available on any node
###############################################################################
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
for _dir in \
    "$HOME/.local/bin" "$HOME/bin" "$HOME/.cargo/bin" "$HOME/.bun/bin" \
    "$HOME/.npm-global/bin" "$PNPM_HOME" "$PNPM_HOME/bin" \
    "$HOME/.lmstudio/bin" "$HOME/google-cloud-sdk/bin" \
    "$HOME/go/bin" "$HOME/Android/Sdk/cmdline-tools/latest/bin" \
    "$HOME/Android/Sdk/platform-tools" "$HOME/Android/Sdk/emulator" \
    "/opt/android-studio-preview/bin" "$HOME/.local/opt/android-studio-preview/bin"
do
    [ -d "$_dir" ] && [[ ":$PATH:" != *":$_dir:"* ]] && PATH="$_dir:$PATH"
done
export PATH
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env" 2>/dev/null || true
if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    \. "$NVM_DIR/nvm.sh" 2>/dev/null || true
fi

###############################################################################
# COLORS & ENVIRONMENT
###############################################################################
BOLD="\033[1m"; GREEN="\033[0;32m"; YELLOW="\033[0;33m"
RED="\033[0;31m"; CYAN="\033[0;36m"; MAGENTA="\033[0;35m"; RESET="\033[0m"
export PYTHONUNBUFFERED=1 GIT_TERMINAL_PROMPT=0 FORCE_COLOR=1 CLICOLOR_FORCE=1
_NPM_GLOBAL_SYNCED=false

###############################################################################
# STEP COUNTER & LOGGING HELPERS
###############################################################################
STEP_COUNT=0; TOTAL_STEPS=0; _SUDO_KEEPALIVE_PID=""; _STEP_START_TIME=0

format_duration() {
    local s="$1"
    if [ "$s" -ge 60 ]; then
        echo "$((s / 60))m $((s % 60))s"
    else
        echo "${s}s"
    fi
}

step() {
    STEP_COUNT=$((STEP_COUNT + 1))
    _STEP_START_TIME=$(date +%s)
    [ "$TOTAL_STEPS" -gt 0 ] \
        && echo -e "\n${BOLD}${GREEN}[+] [${STEP_COUNT}/${TOTAL_STEPS}] $1...${RESET}" \
        || echo -e "\n${BOLD}${GREEN}[+] [${STEP_COUNT}] $1...${RESET}"
}

skip_step() {
    STEP_COUNT=$((STEP_COUNT + 1))
    local title="$1" reason="${2:-not found}"
    [ "$TOTAL_STEPS" -gt 0 ] \
        && echo -e "\n${YELLOW}[-] [${STEP_COUNT}/${TOTAL_STEPS}] ${title} (${reason}, skipping)${RESET}" \
        || echo -e "\n${YELLOW}[-] [${STEP_COUNT}] ${title} (${reason}, skipping)${RESET}"
}

log_substep()  { echo -e "  ${BOLD}${CYAN}--> [$1/$2]${RESET} $3"; }
log_action()   { echo -e "  ${CYAN}... $1${RESET}"; }
log_info()     { echo -e "  ${BOLD}[*] $1${RESET}"; }
log_ok()       {
    if [ "$_STEP_START_TIME" -gt 0 ]; then
        local elapsed=$(( $(date +%s) - _STEP_START_TIME ))
        if [ "$elapsed" -ge 3 ]; then
            echo -e "  ${GREEN}[OK] $1 ${CYAN}(took $(format_duration "$elapsed"))${RESET}"
            _STEP_START_TIME=0
            return
        fi
    fi
    echo -e "  ${GREEN}[OK] $1${RESET}"
    _STEP_START_TIME=0
}
log_warn()     { echo -e "  ${YELLOW}^ WARNING: $1${RESET}"; }
log_err()      { echo -e "  ${RED}^ ERROR: $1${RESET}"; }
log_bootstrap(){ echo -e "  ${BOLD}${MAGENTA}--> [BOOTSTRAP] $1${RESET}"; }

run_or_dry() {
    if [ "${DRY_RUN:-false}" = "true" ]; then
        echo -e "  ${MAGENTA}[DRY-RUN] Would run: $*${RESET}"; return 0
    fi
    if [ "${1:-}" = "sudo" ] && { [ "${2:-}" = "dnf" ] || [ "${2:-}" = "rpm" ]; }; then
        with_rpm_lock "$@"
    else
        "$@"
    fi
}

run_silent_log() {
    if [ "${DRY_RUN:-false}" = "true" ]; then
        echo -e "  ${MAGENTA}[DRY-RUN] Would run: $*${RESET}"; return 0
    fi
    local target_log="${RECIPE_LOG_FILE:-$LOG_FILE}"
    if [ "${1:-}" = "sudo" ] && { [ "${2:-}" = "dnf" ] || [ "${2:-}" = "rpm" ]; }; then
        with_rpm_lock "$@" >> "$target_log" 2>&1
    else
        "$@" >> "$target_log" 2>&1
    fi
}

with_rpm_lock() {
    local lock_file="/tmp/fedora-update-rpm-${UID:-$(id -u)}.lock"
    if command -v flock &>/dev/null; then
        flock -w 600 "$lock_file" "$@"
    else
        "$@"
    fi
}

###############################################################################
# LOGGING — tee to timestamped log + ~/.local/state/update/last-update.log
###############################################################################
init_logging() {
    local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/update"
    mkdir -p "$log_dir"
    LOG_FILE="$log_dir/update_$(date +%Y%m%d_%H%M%S).log"
    LAST_LOG_FILE="$log_dir/last-update.log"
    : > "$LOG_FILE"
    ln -sfn "$LOG_FILE" "$LAST_LOG_FILE" 2>/dev/null || : > "$LAST_LOG_FILE"
    find "$log_dir" -name "update_*.log" -type f 2>/dev/null | sort -r | tail -n +11 | xargs -r rm -f
    exec 3>&1
    exec > >(tee -a "$LOG_FILE") 2>&1
}

###############################################################################
# PASSWORDLESS SUDO & POLKIT AUTO-SETUP
###############################################################################
ensure_passwordless_sudo() {
    ! command -v sudo &>/dev/null && { log_warn "'sudo' not found."; return 0; }
    local sudoers_file="/etc/sudoers.d/$USER"
    local polkit_rule="/etc/polkit-1/rules.d/49-nopasswd-fedora-update.rules"

    _write_polkit_rule() {
        [ -d "/etc/polkit-1/rules.d" ] && [ ! -f "$polkit_rule" ] || return 0
        sudo tee "$polkit_rule" >/dev/null <<EOF
polkit.addRule(function(action, subject) {
    if (subject.user == "$USER" || subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
EOF
        sudo chmod 0644 "$polkit_rule" 2>/dev/null || true
    }

    if sudo -n true 2>/dev/null; then
        _write_polkit_rule
        log_ok "Passwordless sudo & Polkit verified."
    else
        echo -e "\n${BOLD}${CYAN}------------------------------------------------------------${RESET}"
        echo -e "${CYAN}  Configuring passwordless sudo for 1-click runs...${RESET}"
        echo -e "${BOLD}${CYAN}------------------------------------------------------------${RESET}"
        if [ -t 0 ] || [ -e /dev/tty ]; then
            if sudo -v; then
                echo "$USER ALL=(ALL:ALL) NOPASSWD: ALL" | sudo tee "$sudoers_file" >/dev/null
                sudo chmod 0440 "$sudoers_file"; sudo chown root:root "$sudoers_file" 2>/dev/null || true
                _write_polkit_rule
                sudo -n true 2>/dev/null \
                    && log_ok "Passwordless sudo configured for $USER." \
                    || log_warn "Configured rules but validation returned non-zero."
            else
                log_warn "Authentication failed. Privileged operations may prompt."
            fi
        else
            log_warn "Non-interactive session. Run 'update' in a terminal once to finish setup."
        fi
    fi

    # Keep sudo ticket alive for the duration of the run
    if sudo -n true 2>/dev/null; then
        while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done </dev/null >/dev/null 2>&1 &
        _SUDO_KEEPALIVE_PID=$!
        trap '[ -n "$_SUDO_KEEPALIVE_PID" ] && kill -9 "$_SUDO_KEEPALIVE_PID" $(pgrep -P "$_SUDO_KEEPALIVE_PID" 2>/dev/null || true) 2>/dev/null || true' EXIT
    fi
}

###############################################################################
# PROCESS DETECTION & SAFE SHUTDOWN / RESTART
###############################################################################
_is_process_excluded() {
    local pid="$1"
    { [ "$pid" = "$$" ] || [ "$pid" = "${PPID:-0}" ] || [ "$pid" = "${BASHPID:-$$}" ]; } && return 0
    local comm; comm=$(ps -p "$pid" -o comm= 2>/dev/null || true)
    case "$comm" in pgrep|grep|bash|sh|zsh) return 0 ;; esac
    local cmdline; cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
    [[ "$cmdline" == *"telemetry_hook_bundle.js"* || "$cmdline" == *"fedora-update"* ]] && return 0
    return 1
}

_is_ancestor_process() {
    local target_pid="$1"
    local cur="$$"
    while [ -n "$cur" ] && [ "$cur" -gt 0 ] 2>/dev/null; do
        [ "$cur" = "$target_pid" ] && return 0
        cur=$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ' || true)
        [ -z "$cur" ] || [ "$cur" = "0" ] && break
    done
    return 1
}

get_android_studio_pids() {
    local pids; pids="$(pgrep -f 'com.intellij.idea.Main|/android-studio' 2>/dev/null || true)"
    if [ -z "$pids" ]; then
        pids="$(pgrep -x "studio.sh" 2>/dev/null || true; pgrep -x "studio64" 2>/dev/null || true; pgrep -x "studio" 2>/dev/null || true)"
    fi
    local valid_pids=()
    for pid in $pids; do
        _is_process_excluded "$pid" && continue
        local c; c=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
        [[ "$c" == *"android-studio"* || "$c" == *"com.intellij.idea.Main"* || "$c" == *"studio.sh"* || "$c" == *"studio"* ]] && valid_pids+=("$pid")
    done
    echo "${valid_pids[@]}"
}

