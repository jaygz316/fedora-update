        local download_url; download_url="$(echo "$response" | grep -o '"url":"[^"]*"' | cut -d'"' -f4 || true)"
        local current_ide=""; [ -f "$antigravity_ide_dir/.version" ] && current_ide="$(cat "$antigravity_ide_dir/.version" 2>/dev/null || true)"
