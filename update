###############################################################################
# SECTION: CLEANUP — Docker prune, caches, journal vacuum, optional TRIM
###############################################################################
run_cleanup() {
    local do_trim="${1:-false}"

    # Docker
    if command -v docker &>/dev/null && systemctl is-active --quiet docker 2>/dev/null; then
        step "Cleanup: Docker images & BuildKit caches"
        docker image prune -f 2>/dev/null || true
        if [ "$do_trim" = "true" ]; then
            docker builder prune -f --reserved-space 5GB 2>/dev/null || docker builder prune -f --keep-storage 5GB 2>/dev/null || true
            docker image prune -a -f --filter "until=168h" 2>/dev/null || true
        else
            docker builder prune -f --reserved-space 15GB 2>/dev/null || docker builder prune -f --keep-storage 15GB 2>/dev/null || true
        fi
        log_ok "Docker cache optimized."
    else
        skip_step "Docker cleanup" "inactive or not installed"
    fi

    # PackageKit & dev caches
    step "Cleanup: PackageKit & development caches"
    [ -d "/var/cache/PackageKit" ] && sudo rm -rf /var/cache/PackageKit/* 2>/dev/null || true
    command -v uv &>/dev/null && uv cache prune 2>/dev/null || true
    python3 -c "import pip" &>/dev/null && python3 -m pip cache purge >/dev/null 2>&1 || true
    log_ok "Caches pruned."

    # Journal vacuum
    step "Cleanup: System journal vacuum (14d / 500MB)"
    sudo journalctl --vacuum-time=14d --vacuum-size=500M 2>&1 | sed 's/^/  /' \
        || log_warn "Journal vacuum had issues, continuing..."
    log_ok "System logs vacuumed."

    # Optional SSD TRIM
    if [ "$do_trim" = "true" ]; then
        step "Storage: SSD TRIM (fstrim -av)"
        log_info "(Note: TRIM on large Btrfs pools may take several minutes)"
        sudo fstrim -av || log_warn "fstrim had issues, continuing..."
        log_ok "SSD trimmed."
    fi

    # Reboot check
    echo -e "\n${BOLD}${CYAN}============================================================${RESET}"
    echo -e "${BOLD}${CYAN}          Checking for Required Service Restarts            ${RESET}"
    echo -e "${BOLD}${CYAN}============================================================${RESET}"
    if command -v dnf &>/dev/null; then
        if sudo dnf needs-restarting -r >/dev/null 2>&1; then
            log_ok "No reboot required."
        else
            echo -e "\n${BOLD}${RED}╔══════════════════════════════════════════════════════════╗${RESET}"
            echo -e "${BOLD}${RED}║  ⚠  REBOOT REQUIRED — kernel or core libs updated        ║${RESET}"
            echo -e "${BOLD}${RED}╚══════════════════════════════════════════════════════════╝${RESET}"
            echo -e "  Run: ${BOLD}systemctl reboot${RESET}"
        fi
        log_info "Services requiring restart:"
        sudo dnf needs-restarting -s 2>/dev/null | sed 's/^/      /' || true
    fi
}

###############################################################################
# CLI FLAGS & ARGUMENT PARSING
###############################################################################
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DO_TRIM=false; ONLY_MODULE=""; declare -a SKIP_MODULES=(); DRY_RUN=false; export DRY_RUN

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Fedora Fleet Maintenance & Toolchain Sync Suite.

Options:
  --trim           Also perform SSD TRIM (fstrim -av)
  --only=MODULE    Run only one section: core|dnf|flatpak|firmware|ai|dev|git|self|cleanup
  --skip=MODULES   Skip sections; comma-separated or repeated
                   e.g. --skip=dnf,flatpak  or  --skip=dnf --skip=flatpak
  --dry-run, -n    Preview without making system changes
  -h, --help       Show this help

Commands:
  update           Routine maintenance
  update-all       Routine maintenance + SSD TRIM
EOF
    exit 0
}

while [ $# -gt 0 ]; do
    case "$1" in
        --trim)       DO_TRIM=true; shift ;;
        --only=*)     ONLY_MODULE="${1#*=}"; shift ;;
        --skip=*)     IFS=',' read -ra _sk <<< "${1#*=}"; SKIP_MODULES+=("${_sk[@]}"); shift ;;
        --dry-run|-n) DRY_RUN=true; shift ;;
        -h|--help)    usage ;;
        *)            shift ;;
    esac
done

should_run() {
    local k="$1"
    [ -n "$ONLY_MODULE" ] && [ "$ONLY_MODULE" != "$k" ] && return 1
    if [ "${#SKIP_MODULES[@]}" -gt 0 ]; then
        local s; for s in "${SKIP_MODULES[@]}"; do [ "$s" = "$k" ] && return 1; done
    fi
    return 0
}

run_module() {
    local key="$1" fn="$2"; shift 2
    should_run "$key" || return 0
    local t0 t1; t0=$(date +%s); "$fn" "$@"; t1=$(date +%s)
    echo -e "  ${CYAN}[${key} time: $((t1 - t0))s]${RESET}"
}

###############################################################################
# MAIN
###############################################################################
main() {
    init_logging
    local START_TIME; START_TIME=$(date +%s)

    [ "$DRY_RUN" = "true" ] && echo -e "${BOLD}${YELLOW}============================================================\n   DRY-RUN MODE — No system changes will be made\n============================================================${RESET}\n"

    echo -e "${BOLD}${CYAN}============================================================${RESET}"
    echo -e "${BOLD}${CYAN}          Starting Fedora Fleet Maintenance Suite           ${RESET}"
    echo -e "${BOLD}${CYAN}  Log: $LOG_FILE${RESET}"
    echo -e "${BOLD}${CYAN}============================================================${RESET}\n"

    # Self-register symlinks on first run / after Syncthing sync to a new node
    chmod +x "$SCRIPT_DIR/update" "$SCRIPT_DIR/update-all" "$SCRIPT_DIR/install.sh" 2>/dev/null || true
    mkdir -p "$HOME/.local/bin"
    [ "$(readlink -f "$HOME/.local/bin/update" 2>/dev/null)" != "$SCRIPT_DIR/update" ] && \
        ln -sf "$SCRIPT_DIR/update" "$HOME/.local/bin/update" 2>/dev/null || true
    [ "$(readlink -f "$HOME/.local/bin/update-all" 2>/dev/null)" != "$SCRIPT_DIR/update-all" ] && \
        ln -sf "$SCRIPT_DIR/update-all" "$HOME/.local/bin/update-all" 2>/dev/null || true

    ensure_passwordless_sudo

    TOTAL_STEPS=0
    should_run "core"     && TOTAL_STEPS=$((TOTAL_STEPS + 18))
    should_run "dnf"      && TOTAL_STEPS=$((TOTAL_STEPS + 3))
    should_run "flatpak"  && TOTAL_STEPS=$((TOTAL_STEPS + 2))
    should_run "firmware" && TOTAL_STEPS=$((TOTAL_STEPS + 1))
    should_run "ai"       && TOTAL_STEPS=$((TOTAL_STEPS + 3))
    should_run "dev"      && TOTAL_STEPS=$((TOTAL_STEPS + 4))
    should_run "git"      && TOTAL_STEPS=$((TOTAL_STEPS + 1))
    should_run "self"     && TOTAL_STEPS=$((TOTAL_STEPS + 1))
    should_run "cleanup"  && {
        [ "$DO_TRIM" = "true" ] && TOTAL_STEPS=$((TOTAL_STEPS + 4)) || TOTAL_STEPS=$((TOTAL_STEPS + 3))
    }

    run_module "core"     run_core_baseline
    run_module "dnf"      run_system_dnf
    run_module "flatpak"  run_flatpak
    run_module "firmware" run_firmware
    run_module "ai"       run_ai_runtimes
    run_module "dev"      run_dev_toolchains
    run_module "git"      run_git_docs
    run_module "self"     run_self_update
    run_module "cleanup"  run_cleanup "$DO_TRIM"

    local END_TIME DURATION
    END_TIME=$(date +%s); DURATION=$((END_TIME - START_TIME))

    echo -e "\n${BOLD}${GREEN}============================================================${RESET}"
    echo -e "${BOLD}${GREEN}  --- Update complete in ${DURATION}s! ---${RESET}"
    echo -e "${CYAN}  Log: ${LOG_FILE}${RESET}"
    echo -e "${BOLD}${GREEN}============================================================${RESET}\n"

    command -v notify-send &>/dev/null && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && \
        notify-send --icon=software-update-available --urgency=normal \
            "Fedora Update Complete" "Done in ${DURATION}s. Log: $LOG_FILE" 2>/dev/null || true
}

main "$@"
