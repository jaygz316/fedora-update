if [ -d "$HOME/google-cloud-sdk" ] && command -v gcloud &> /dev/null; then
    step "Updating Google Cloud SDK components"
    gcloud components update --quiet || echo -e "  ${RED}^ WARNING: Google Cloud SDK update failed, continuing...${RESET}"
else
    skip_step "Google Cloud SDK"
fi

# 5. Android SDK
if command -v android &> /dev/null; then
