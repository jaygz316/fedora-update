#!/usr/bin/env bash
#
# update: Standalone system update utility
# Location: ~/.local/bin/update
#

set -u

# Ensure PATH includes all user toolchains and binaries
for dir in \
    "$HOME/.local/bin" \
    "$HOME/bin" \
    "$HOME/.cargo/bin" \
    "$HOME/.bun/bin" \
    "$HOME/.npm-global/bin" \
    "$HOME/.lmstudio/bin" \
    "$HOME/google-cloud-sdk/bin" \
    "$HOME/go/bin"
do
    if [ -d "$dir" ] && [[ ":$PATH:" != *":$dir:"* ]]; then
        PATH="$dir:$PATH"
    fi
done
export PATH

# Persistent logging configuration
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/update"
mkdir -p "$LOG_DIR"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
LOG_FILE="$LOG_DIR/update_${TIMESTAMP}.log"
LAST_LOG="$LOG_DIR/last-update.log"

# Clean up older log files (keep last 10)
find "$LOG_DIR" -name "update_*.log" -type f 2>/dev/null | sort -r | tail -n +11 | xargs -r rm -f

# Redirect output to both terminal and log file
exec > >(tee -a "$LOG_FILE" | tee "$LAST_LOG") 2>&1

# Formatting & Colors
BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
CYAN="\033[0;36m"
RESET="\033[0m"

START_TIME=$(date +%s)

echo -e "${BOLD}${CYAN}==========================================${RESET}"
echo -e "${BOLD}${CYAN}          Starting System Update          ${RESET}"
echo -e "${BOLD}${CYAN}  Log: $LOG_FILE${RESET}"
echo -e "${BOLD}${CYAN}==========================================${RESET}\n"

# Sudo credentials keepalive (prompts once upfront if needed)
if command -v sudo &>/dev/null; then
    if sudo -v 2>/dev/null; then
        while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
        SUDO_PID=$!
        trap 'kill "$SUDO_PID" 2>/dev/null || true' EXIT
    fi
fi

# Step counter helper
STEP_COUNT=0
TOTAL_STEPS=26

step() {
    ((STEP_COUNT++))
    echo -e "\n${BOLD}${GREEN}[+] ${STEP_COUNT}/${TOTAL_STEPS} $1...${RESET}"
}

skip_step() {
    ((STEP_COUNT++))
    echo -e "\n${YELLOW}[-] ${STEP_COUNT}/${TOTAL_STEPS} $1 (not found, skipping)${RESET}"
}

# Helper function to update git repositories safely with version check
_update_git_repo() {
    local repo_path="$1"
    local repo_name
    repo_name="$(basename "$repo_path")"
    if [ -d "$repo_path" ]; then
        (
            cd "$repo_path" || return 1
            if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                git fetch --quiet --all --prune
                local local_commit upstream_commit
                local_commit="$(git rev-parse HEAD 2>/dev/null)"
                upstream_commit="$(git rev-parse '@{u}' 2>/dev/null)"
                if [ -n "$local_commit" ] && [ "$local_commit" = "$upstream_commit" ]; then
                    echo -e "  ${GREEN}[OK] $repo_name is already up to date.${RESET}"
                else
                    echo -e "  ${BOLD}[*] Pulling latest changes for $repo_name...${RESET}"
                    git pull --rebase --autostash
                fi
            else
                echo -e "  ${YELLOW}^ WARNING: $repo_path is not a valid Git repository.${RESET}"
                return 1
            fi
        ) || echo -e "  ${YELLOW}^ WARNING: Failed to update git repo at $repo_path${RESET}"
    else
        echo -e "  ${YELLOW}^ WARNING: Directory $repo_path does not exist.${RESET}"
    fi
}

# Helper function to update Go tools only if upstream module version differs
_update_go_tool() {
    local bin_name="$1"
    local install_path="$2"
    local bin_path="$HOME/go/bin/$bin_name"

    if [ -x "$bin_path" ]; then
        local mod_line mod_path current_ver latest_ver
        mod_line="$(go version -m "$bin_path" 2>/dev/null | grep -E "^\s*mod\s+" | head -n 1)"
        mod_path="$(echo "$mod_line" | awk '{print $2}')"
        current_ver="$(echo "$mod_line" | awk '{print $3}')"

        if [ -n "$mod_path" ]; then
            latest_ver="$(curl -s --max-time 3 "https://proxy.golang.org/$mod_path/@latest" 2>/dev/null | grep -o '"Version":"[^"]*"' | cut -d'"' -f4)"
        fi

        if [ -n "$current_ver" ] && [ -n "$latest_ver" ] && [ "$current_ver" = "$latest_ver" ]; then
            echo -e "  ${GREEN}[OK] $bin_name is already up to date ($current_ver).${RESET}"
            return 0
        fi
    fi

    echo -e "  ${BOLD}[*] Updating $bin_name ($install_path)...${RESET}"
    go install "$install_path@latest"
}

# 1. DNF Packages
step "Refreshing and upgrading DNF packages"
sudo dnf upgrade --refresh -y || echo -e "  ${RED}^ WARNING: DNF upgrade failed, continuing...${RESET}"
sudo dnf autoremove -y || echo -e "  ${RED}^ WARNING: DNF autoremove failed, continuing...${RESET}"
sudo dnf clean packages -y >/dev/null 2>&1 || true

# 2. Flatpaks
if command -v flatpak &> /dev/null; then
    step "Updating Flatpaks and cleaning unused runtimes"
    flatpak update -y || flatpak update --no-static-deltas -y || echo -e "  ${RED}^ WARNING: Flatpak update failed, continuing...${RESET}"
    flatpak uninstall --unused -y || echo -e "  ${RED}^ WARNING: Flatpak cleanup failed, continuing...${RESET}"
else
    skip_step "Flatpak CLI"
fi

# 3. System & Hardware Firmware (LVFS)
if command -v fwupdmgr &> /dev/null; then
    step "Checking system & hardware firmware updates (LVFS)"
    fwupdmgr refresh --no-unreported-check >/dev/null 2>&1 || true
    if fwupdmgr get-updates --no-unreported-check >/dev/null 2>&1; then
        fwupdmgr get-updates --no-unreported-check
    else
        fwupd_status=$?
        if [ "$fwupd_status" -eq 2 ]; then
            echo -e "  ${GREEN}[OK] All device and system firmware is up to date.${RESET}"
        else
            echo -e "  ${YELLOW}^ WARNING: Firmware check failed with status $fwupd_status, continuing...${RESET}"
        fi
    fi
else
    skip_step "'fwupdmgr'"
fi

