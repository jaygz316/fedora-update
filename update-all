# 12. Ollama
if command -v ollama &> /dev/null; then
    step "Checking Ollama & model updates"
    current_ollama="$(ollama --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)"
    latest_ollama="$(curl -s --max-time 3 "https://api.github.com/repos/ollama/ollama/releases/latest" 2>/dev/null | grep -m1 '"tag_name":' | sed -E 's/.*"v?([0-9.]+).*/\1/' || true)"
    if [ -n "$current_ollama" ] && [ -n "$latest_ollama" ] && [ "$current_ollama" = "$latest_ollama" ]; then
        echo -e "  ${GREEN}[OK] Ollama is already up to date ($current_ollama).${RESET}"
    else
        echo -e "  ${BOLD}[*] Upgrading Ollama (${current_ollama:-unknown} -> ${latest_ollama:-latest})...${RESET}"
        curl -fsSL https://ollama.com/install.sh | sh || echo -e "  ${RED}^ WARNING: Ollama update failed, continuing...${RESET}"
    fi

    # Update installed Ollama models
    if ollama_list="$(ollama list 2>/dev/null)"; then
        models="$(echo "$ollama_list" | tail -n +2 | awk '{print $1}' | grep -v '^$' || true)"
        if [ -n "$models" ]; then
            echo -e "  ${BOLD}[*] Updating installed Ollama models...${RESET}"
            while IFS= read -r model; do
                if [ -n "$model" ]; then
                    echo -e "  ${BOLD}--> Pulling latest $model...${RESET}"
                    ollama pull "$model" || echo -e "  ${YELLOW}^ WARNING: Failed to update Ollama model '$model', continuing...${RESET}"
                fi
            done <<< "$models"
            echo -e "  ${GREEN}[OK] Ollama models checked.${RESET}"
        else
            echo -e "  ${GREEN}[OK] No Ollama models installed.${RESET}"
        fi
    else
        echo -e "  ${YELLOW}^ WARNING: Ollama service is not running; skipping model updates.${RESET}"
    fi
