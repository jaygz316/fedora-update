    agy update || echo -e "  ${RED}^ WARNING: Agy update failed, continuing...${RESET}"
else
    skip_step "'agy' command"
fi

# 7. Google Antigravity Desktop
antigravity_dir="$HOME/.local/opt/antigravity"
if [ -d "$antigravity_dir" ] || [ -f "$HOME/.local/bin/antigravity" ]; then
    step "Checking Google Antigravity Desktop updates"
    
    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            arch_dir="linux-x64"
            ;;
        aarch64|arm64)
            arch_dir="linux-arm"
            ;;
        *)
            echo -e "  ${YELLOW}^ WARNING: Unsupported architecture: $arch${RESET}"
            arch_dir=""
            ;;
    esac

    if [ -n "$arch_dir" ]; then
        manifest_url="https://antigravity-hub-auto-updater-974169037036.us-central1.run.app/manifest/latest-x64-linux.yml"
        manifest_data="$(curl -s --max-time 5 "$manifest_url" 2>/dev/null || true)"
        
        current_antigravity=""
        if [ -f "$antigravity_dir/.version" ]; then
            current_antigravity="$(cat "$antigravity_dir/.version" 2>/dev/null || true)"
        fi
        if [ -z "$current_antigravity" ] && [ -f "$antigravity_dir/resources/app.asar" ] && command -v npx &>/dev/null; then
            tmp_asar_dir="$(mktemp -d -t antigravity-asar-XXXXXX)"
            current_antigravity="$( (cd "$tmp_asar_dir" && npx -y @electron/asar extract-file "$antigravity_dir/resources/app.asar" package.json >/dev/null 2>&1 && grep '"version"' package.json 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true) | head -n 1)"
            rm -rf "$tmp_asar_dir"
        fi

        latest_antigravity="$(echo "$manifest_data" | grep -E '^version:' | awk '{print $2}' || true)"

        if [ -n "$current_antigravity" ] && [ -n "$latest_antigravity" ] && [ "$current_antigravity" = "$latest_antigravity" ]; then
            echo -e "  ${GREEN}[OK] Google Antigravity is already up to date ($current_antigravity).${RESET}"
        elif [ -n "$manifest_data" ] && [ -n "$latest_antigravity" ]; then
            echo -e "  ${BOLD}[*] Upgrading Google Antigravity (${current_antigravity:-unknown} -> $latest_antigravity)...${RESET}"
            base_url="$(echo "$manifest_data" | grep -o 'https://storage.googleapis.com/antigravity-public/antigravity-hub/[^/]*' | head -n 1)"
            download_url="${base_url}/${arch_dir}/Antigravity.tar.gz"

            tmp_work_dir="$(mktemp -d -t antigravity-update-XXXXXX)"
            tarball_tmp="${tmp_work_dir}/Antigravity.tar.gz"
            extract_dir="${tmp_work_dir}/extract"
            mkdir -p "$extract_dir"

            echo -e "  ${BOLD}--> Downloading $download_url...${RESET}"
            if curl -# -fSL -o "$tarball_tmp" "$download_url"; then
                echo -e "  ${BOLD}--> Installing update...${RESET}"
                tar -xzf "$tarball_tmp" -C "$extract_dir"
                payload_dir="$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
                if [ -z "$payload_dir" ]; then
                    payload_dir="$extract_dir"
                fi

                if [ -d "$payload_dir" ] && [ -f "$payload_dir/antigravity" ]; then
                    rm -rf "$antigravity_dir"
                    mkdir -p "$antigravity_dir"
                    mv "$payload_dir"/* "$antigravity_dir/"
                    chmod +x "$antigravity_dir/antigravity"
                    echo "$latest_antigravity" > "$antigravity_dir/.version"

                    if [ -f "$antigravity_dir/resources/app.asar" ] && command -v npx &>/dev/null; then
                        (cd "$antigravity_dir" && npx -y @electron/asar extract-file resources/app.asar icon.png >/dev/null 2>&1) || true
                    fi

                    mkdir -p "$HOME/.local/share/applications" "$HOME/Desktop" "$HOME/.local/bin"
                    cat << DESKTOP > "$HOME/.local/share/applications/antigravity.desktop"
[Desktop Entry]
Name=Antigravity
Exec=$antigravity_dir/antigravity --no-sandbox
Icon=$antigravity_dir/icon.png
Type=Application
Terminal=false
Categories=Development;IDE;
DESKTOP
                    cp "$HOME/.local/share/applications/antigravity.desktop" "$HOME/Desktop/" 2>/dev/null || true
                    chmod +x "$HOME/Desktop/antigravity.desktop" 2>/dev/null || true

                    cat << WRAPPER > "$HOME/.local/bin/antigravity"
#!/bin/bash
exec "$antigravity_dir/antigravity" --no-sandbox "\$@"
WRAPPER
                    chmod +x "$HOME/.local/bin/antigravity"

                    echo -e "  ${GREEN}[OK] Google Antigravity successfully updated to $latest_antigravity.${RESET}"
                else
                    echo -e "  ${RED}^ WARNING: Extraction failed (Antigravity binary not found in archive).${RESET}"
                fi
            else
                echo -e "  ${RED}^ WARNING: Failed to download Antigravity from $download_url${RESET}"
            fi
            rm -rf "$tmp_work_dir"
        else
            echo -e "  ${YELLOW}^ WARNING: Unable to fetch Antigravity update manifest, continuing...${RESET}"
        fi
    fi
else
    skip_step "Google Antigravity Desktop"
fi

