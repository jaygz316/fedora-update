    fi
else
    skip_step "'gh' command"
fi

# 24. Local Git Repositories & Agent Frameworks
step "Updating local Git repositories & documentation"
_update_git_repo "$HOME/.hermes/hermes-agent"
# Keep Hermes virtualenv dependencies synchronized if repo was updated
if [ -d "$HOME/.hermes/hermes-agent/venv" ]; then
    "$HOME/.hermes/hermes-agent/venv/bin/pip" install --upgrade -e "$HOME/.hermes/hermes-agent" --quiet 2>/dev/null || true
fi
_update_git_repo "$HOME/projects/docs/androidx"
_update_git_repo "$HOME/projects/docs/compose-samples"
_update_git_repo "$HOME/projects/docs/horologist"
_update_git_repo "$HOME/projects/docs/nowinandroid"

# 25. Docker Cleanup
if command -v docker &> /dev/null && systemctl is-active --quiet docker 2>/dev/null; then
    step "Pruning unused Docker dangling images"
    docker image prune -f || echo -e "  ${YELLOW}^ WARNING: Docker image prune failed, continuing...${RESET}"
else
    skip_step "Docker service"
fi

# 26. System Journal & SSD Maintenance
step "Optimizing system logs (journalctl) and trimming SSD (fstrim)"
echo -e "  ${BOLD}[*] Vacuuming systemd journal logs (keeping 14 days / max 500MB)...${RESET}"
sudo journalctl --vacuum-time=14d --vacuum-size=500M >/dev/null 2>&1 || echo -e "  ${YELLOW}^ WARNING: journalctl vacuuming failed, continuing...${RESET}"
echo -e "  ${BOLD}[*] Performing SSD TRIM...${RESET}"
sudo fstrim -av >/dev/null 2>&1 || echo -e "  ${YELLOW}^ WARNING: fstrim failed, continuing...${RESET}"
echo -e "  ${GREEN}[OK] System logs vacuumed and SSD trimmed.${RESET}"

# Post-Update Reboot & Service Checks
echo -e "\n${BOLD}${CYAN}==========================================${RESET}"
echo -e "${BOLD}${CYAN}   Checking for Required Service Restarts ${RESET}"
echo -e "${BOLD}${CYAN}==========================================${RESET}"

if command -v dnf &> /dev/null; then
    # Check if a reboot is needed (kernel, glibc, systemd)
    if sudo dnf needs-restarting -r >/dev/null 2>&1; then
        echo -e "${GREEN}  [OK] No system reboot required.${RESET}"
    else
        echo -e "${YELLOW}  [!] A system reboot is RECOMMENDED (kernel or core libraries updated).${RESET}"
    fi

    # Check which background services need restarting
    echo -e "${BOLD}  [*] Checking active services requiring restart:${RESET}"
    sudo dnf needs-restarting -s 2>/dev/null | sed 's/^/      /' || true
fi

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo -e "\n${BOLD}${GREEN}--- Update process complete in ${DURATION}s! ---${RESET}"
echo -e "${CYAN}Full execution log saved to: ${LOG_FILE}${RESET}\n"
